---
/**
 * Root landing: client-side language detection, then redirect.
 *
 * Statically generated as `/index.html`. The browser executes the inline
 * script, reads `navigator.languages`, and replaces the URL with the best
 * matching locale. The site is tiny, so this happens before paint.
 *
 * Fallbacks:
 *  - <noscript>: hard meta refresh to /en/ (the default locale).
 *  - Any locale not in LOCALES list: also /en/.
 *
 * To add a new locale: add it to LOCALES below AND in astro.config.mjs.
 */
const SUPPORTED = ['en', 'it'];
const DEFAULT = 'en';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI-Guide</title>
    <meta name="robots" content="noindex" />
    <noscript>
      <meta http-equiv="refresh" content={`0;url=/${DEFAULT}/`} />
    </noscript>
    <script is:inline define:vars={{ SUPPORTED, DEFAULT }}>
      (function () {
        try {
          const langs =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || navigator.userLanguage || DEFAULT];

          let target = DEFAULT;
          for (const raw of langs) {
            if (!raw) continue;
            const base = String(raw).toLowerCase().split('-')[0];
            if (SUPPORTED.indexOf(base) !== -1) {
              target = base;
              break;
            }
          }

          window.location.replace('/' + target + '/');
        } catch (_e) {
          window.location.replace('/' + DEFAULT + '/');
        }
      })();
    </script>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #fceee3;
        color: #2a2447;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          'Helvetica Neue', Arial, sans-serif;
      }
      .fallback {
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        text-align: center;
        font-size: 1rem;
      }
      .fallback a {
        color: #c25a3f;
      }
    </style>
  </head>
  <body>
    <div class="fallback">
      <p>
        Loading AI-Guide... If nothing happens,
        <a href={`/${DEFAULT}/`}>open the site</a>.
      </p>
    </div>
  </body>
</html>
