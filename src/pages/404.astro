---
import '../styles/custom.css';
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>404 · AI-Guide</title>
  </head>
  <body>
    <main class="nf-main">
      <p class="nf-code">404</p>
      <h1 class="nf-title">Questa pagina non esiste</h1>
      <p class="nf-title-en" lang="en">This page doesn't exist</p>
      <p class="nf-body">
        Forse il link era sbagliato, o la pagina è stata spostata.
        <span lang="en">/ Maybe the link was wrong, or the page has moved.</span>
      </p>
      <p class="nf-actions">
        <a href="/it/">Torna alla home (IT)</a>
        <span aria-hidden="true">·</span>
        <a href="/en/" lang="en">Back to home (EN)</a>
      </p>
    </main>
    <style>
      body {
        font-family: var(--sl-font);
        background: var(--sl-color-bg);
        color: var(--sl-color-text);
        margin: 0;
      }
      .nf-main {
        max-width: 560px;
        margin: 0 auto;
        padding: 6rem 1.5rem 4rem;
        text-align: center;
      }
      .nf-code {
        font-size: 5rem;
        font-weight: 700;
        color: var(--sl-color-accent);
        margin: 0;
        letter-spacing: -0.02em;
      }
      .nf-title {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0.5rem 0 0.25rem;
      }
      .nf-title-en {
        margin: 0;
        color: var(--sl-color-gray-3);
        font-size: 1.15rem;
      }
      .nf-body {
        margin: 1.5rem 0 2rem;
        color: var(--sl-color-gray-3);
        line-height: 1.6;
      }
      .nf-actions {
        display: flex;
        justify-content: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
      .nf-actions a {
        color: var(--sl-color-text-accent);
        text-decoration: none;
        font-weight: 600;
      }
      .nf-actions a:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .nf-actions a:focus-visible {
        outline: 2px solid var(--sl-color-accent);
        outline-offset: 2px;
        border-radius: 0.25rem;
      }
      .nf-actions span {
        color: var(--sl-color-gray-4);
      }
    </style>
  </body>
</html>
