---
/**
 * Local in-browser AI assistant.
 *
 * Floating launcher (bottom-right) + side drawer / bottom sheet. The
 * model runs entirely in the browser via @mlc-ai/web-llm in a Web
 * Worker; nothing is downloaded or sent until the reader consents on
 * the consent screen. Rendered once per page by Footer.astro.
 *
 * All UI strings and config are server-rendered and handed to the
 * client custom element (`<local-ai>`) via data-* attributes, the same
 * pattern as Search.astro / LlmExercise.astro.
 *
 * STYLE NOTE: <style is:global> is intentional — the panel's views are
 * built at runtime by chat-ui.ts, which creates DOM elements that do not
 * receive Astro's scoping attribute (data-astro-cid). Every selector is
 * prefixed with `local-ai ` to maintain specificity isolation, mirroring
 * the pattern used in Search.astro.
 */
import { t, getLocale } from '../../i18n/ui';

const ui = t(Astro.currentLocale);
const locale = getLocale(Astro.currentLocale);
const privacyHref = `/${locale}/privacy/`;

const models = [
  { id: 'onnx-community/Qwen2.5-0.5B-Instruct', tier: 'light',  name: 'Qwen2.5 0.5B', size: '0.4 GB', dtype: 'q4' },
  { id: 'onnx-community/Qwen2.5-1.5B-Instruct', tier: 'better', name: 'Qwen2.5 1.5B', size: '1.0 GB', dtype: 'q4f16' },
  { id: 'onnx-community/gemma-4-E2B-it-ONNX',   tier: 'best',   name: 'Gemma 4 E2B',  size: '1.5 GB', dtype: 'q4f16' },
] as const;

const i18n = {
  panelTitle:         ui.localAiPanelTitle,
  close:              ui.localAiClose,
  consentHeading:     ui.localAiConsentHeading,
  consentBody:        ui.localAiConsentBody,
  consentPrivacy:     ui.localAiConsentPrivacy,
  consentPrivacyLink: ui.localAiConsentPrivacyLink,
  consentConfirm:     ui.localAiConsentConfirm,
  recommended:        ui.localAiRecommended,
  downloading:        ui.localAiDownloading,
  inputPlaceholder:   ui.localAiInputPlaceholder,
  send:               ui.localAiSend,
  thinking:           ui.localAiThinking,
  startExercise:      ui.localAiStartExercise,
  noWebgpuTitle:      ui.localAiNoWebgpuTitle,
  noWebgpuBody:       ui.localAiNoWebgpuBody,
  errorTitle:         ui.localAiErrorTitle,
  errorBody:          ui.localAiErrorBody,
  retryLight:         ui.localAiRetryLight,
  disclaimer:         ui.localAiDisclaimer,
  modelsTitle:        ui.localAiModelsTitle,
  newChatAria:        ui.localAiNewChatAria,
  modelsAria:         ui.localAiModelsAria,
  backAria:           ui.localAiBackAria,
  oneTime:            ui.localAiOneTime,
  use:                ui.localAiUse,
  downloadModel:      ui.localAiDownloadModel,
  deleteModel:        ui.localAiDeleteModel,
  statusActive:       ui.localAiStatusActive,
  statusCached:       ui.localAiStatusCached,
  statusIdle:         ui.localAiStatusIdle,
  tierLight:          ui.localAiTierLight,
  tierBetter:         ui.localAiTierBetter,
  tierBest:           ui.localAiTierBest,
  descLight:          ui.localAiDescLight,
  descBetter:         ui.localAiDescBetter,
  descBest:           ui.localAiDescBest,
  bestWarn:           ui.localAiModelBestWarn,
  confirmDelete:      ui.localAiConfirmDelete,
};
---

<local-ai
  data-locale={locale}
  data-privacy-href={privacyHref}
  data-models={JSON.stringify(models)}
  data-i18n={JSON.stringify(i18n)}
>
  <button type="button" class="lai-launcher" aria-expanded="false" aria-label={ui.localAiLauncherAria}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3l2.1 4.9L19 10l-4.9 2.1L12 17l-2.1-4.9L5 10l4.9-2.1z" />
    </svg>
    <span class="lai-launcher-text">{ui.localAiLauncherLabel}</span>
  </button>

  <section class="lai-panel" role="dialog" aria-label={ui.localAiPanelTitle} aria-modal="false" hidden>
    <header class="lai-head">
      <span class="lai-spark" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="lai-ic" aria-hidden="true">
          <path d="M12 3l2.1 4.9L19 10l-4.9 2.1L12 17l-2.1-4.9L5 10l4.9-2.1z" />
        </svg>
      </span>
      <div class="lai-title">
        <b data-panel-title>{ui.localAiPanelTitle}</b>
        <span class="lai-sub" data-status-sub></span>
      </div>
      <!-- Chat-view controls (shown only when data-view="chat") -->
      <button type="button" class="lai-icon-btn lai-chat-ctrl" data-new-chat aria-label={ui.localAiNewChatAria}>
        <svg viewBox="0 0 24 24" class="lai-ic" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <button type="button" class="lai-icon-btn lai-chat-ctrl" data-open-models aria-label={ui.localAiModelsAria}>
        <svg viewBox="0 0 24 24" class="lai-ic" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0v-.1A1.6 1.6 0 0 0 7 19.4a1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0-1.1-2.7H1a2 2 0 1 1 0-4h.1A1.6 1.6 0 0 0 2.6 7a1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H7a1.6 1.6 0 0 0 1-1.5V1a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 2.7 1.1 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V7a1.6 1.6 0 0 0 1.5 1H23a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z"/></svg>
      </button>
      <!-- Models-view back button (shown only when data-view="models") -->
      <button type="button" class="lai-icon-btn lai-models-ctrl" data-back-chat aria-label={ui.localAiBackAria}>
        <svg viewBox="0 0 24 24" class="lai-ic" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <!-- Always-visible close button -->
      <button type="button" class="lai-icon-btn" aria-label={ui.localAiClose} data-close>
        <svg viewBox="0 0 24 24" class="lai-ic" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </header>
    <div class="lai-body" data-body></div>
  </section>
</local-ai>

<script>
  import './chat-ui.ts';
</script>

<style is:global>
  /* ============================================================
     Local AI panel · global styles prefixed with `local-ai`.
     Global (not scoped) because the panel views are built at
     runtime by chat-ui.ts. Elements created by JS do not receive
     Astro's scoping attribute (data-astro-cid), so scoped rules
     would not apply to them. Every selector is prefixed with
     `local-ai ` for isolation. Same pattern as Search.astro.
     ============================================================ */

  local-ai { display: contents; }

  /* ---- Launcher -------------------------------------------- */
  local-ai .lai-launcher {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    font-family: var(--sl-font);
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow:
      0 6px 20px rgba(var(--aig-shadow-color), 0.22),
      0 2px 6px rgba(var(--aig-shadow-color), 0.1);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  local-ai .lai-launcher:hover {
    background: var(--sl-color-accent-high);
    transform: translateY(-1px);
  }
  local-ai .lai-launcher:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  /* ---- Panel shell ----------------------------------------- */
  local-ai .lai-panel {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 81;
    width: 384px;
    max-width: calc(100vw - 2rem);
    height: min(620px, calc(100vh - 2rem));
    display: flex;
    flex-direction: column;
    background: var(--aig-elevated-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 18px;
    box-shadow:
      0 18px 48px rgba(var(--aig-shadow-color), 0.16),
      0 3px 10px rgba(var(--aig-shadow-color), 0.06);
    overflow: hidden;
  }
  local-ai .lai-panel[hidden] { display: none; }

  /* ---- Header ---------------------------------------------- */
  local-ai .lai-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 0.9rem 0.85rem 1.1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    background: linear-gradient(180deg, var(--aig-elevated-bg-warm), var(--aig-elevated-bg));
    flex-shrink: 0;
  }

  /* Spark icon square */
  local-ai .lai-spark {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    display: grid;
    place-items: center;
    flex: none;
  }

  /* Title block */
  local-ai .lai-title {
    flex: 1;
    min-width: 0;
  }
  local-ai .lai-title b {
    display: block;
    font-size: 0.95rem;
    line-height: 1.2;
    color: var(--sl-color-text);
  }
  local-ai .lai-sub {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.74rem;
    color: var(--sl-color-gray-2);
    margin-top: 0.05rem;
  }

  /* Status dot — intentional status colors (no Pastello token for sage/muted) */
  local-ai .lai-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #5E8B6A;          /* sage: model cached/ready */
    box-shadow: 0 0 0 3px #E7F0E8; /* sage-bg: subtle halo */
    flex: none;
  }
  local-ai .lai-dot.lai-dot-idle {
    background: #9A93AC;          /* muted: model loading/idle */
    box-shadow: none;
  }

  /* Icon buttons in header */
  local-ai .lai-icon-btn {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 0;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    display: grid;
    place-items: center;
    flex: none;
    transition: background 0.12s, color 0.12s;
  }
  local-ai .lai-icon-btn:hover {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  local-ai .lai-icon-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* Show/hide header controls based on current view */
  local-ai .lai-chat-ctrl   { display: none; }
  local-ai .lai-models-ctrl { display: none; }
  local-ai .lai-panel[data-view="chat"]   .lai-chat-ctrl   { display: grid; }
  local-ai .lai-panel[data-view="models"] .lai-models-ctrl { display: grid; }

  /* SVG icon base (reused by all lai-ic) */
  local-ai .lai-ic {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  /* ---- Body (scrollable content area) ---------------------- */
  local-ai .lai-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  /* ---- Consent view ---------------------------------------- */
  local-ai .lai-lead {
    margin-bottom: 0.75rem;
  }
  local-ai .lai-lead h3 {
    margin: 0 0 0.35rem;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
    color: var(--sl-color-text);
  }
  local-ai .lai-lead p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  local-ai .lai-consent-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Model option cards */
  local-ai .lai-opt {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 0.7rem;
    padding: 0.8rem 0.85rem;
    border: 1.5px solid var(--sl-color-hairline);
    border-radius: 12px;
    cursor: pointer;
    position: relative;
    transition: border-color 0.15s, background 0.15s;
  }
  local-ai .lai-opt:hover { border-color: var(--sl-color-accent); }
  local-ai .lai-opt.lai-sel {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  /* Radio circle */
  local-ai .lai-radio {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-4);
    margin-top: 2px;
    flex: none;
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  local-ai .lai-opt.lai-sel .lai-radio {
    border-color: var(--sl-color-accent);
    box-shadow: inset 0 0 0 3.5px var(--sl-color-accent);
  }

  /* Option tier row (row 1) */
  local-ai .lai-opt-tier {
    font-weight: 600;
    font-size: 0.92rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    color: var(--sl-color-text);
  }

  /* Option model name (row 2, smaller/muted) */
  local-ai .lai-opt-model-name {
    font-size: 0.78rem;
    color: var(--sl-color-gray-2);
    margin-top: 0.18rem;
  }

  /* Option description (row 3) */
  local-ai .lai-opt-desc {
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
    margin-top: 0.22rem;
    line-height: 1.45;
  }

  /* "Recommended" chip */
  local-ai .lai-chip {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  /* Caution note inside a card */
  local-ai .lai-warn {
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
    margin-top: 0.45rem;
    font-size: 0.78rem;
    color: var(--aig-caution-text);
    background: var(--aig-caution-bg);
    border: 1px solid var(--aig-caution-border);
    border-radius: 8px;
    padding: 0.4rem 0.55rem;
  }
  local-ai .lai-warn .lai-ic {
    width: 15px;
    height: 15px;
    flex: none;
    margin-top: 1px;
  }

  /* CTA wrapper in consent view */
  local-ai .lai-consent-cta {
    margin-top: 0.25rem;
  }

  /* Buttons */
  local-ai .lai-btn {
    appearance: none;
    border: 1px solid var(--sl-color-hairline);
    background: var(--aig-elevated-bg);
    color: var(--sl-color-text);
    font-family: var(--sl-font);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1rem;
    border-radius: 10px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    transition: background 0.12s, border-color 0.12s;
  }
  local-ai .lai-btn:hover { background: var(--aig-elevated-bg-warm); }
  local-ai .lai-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  local-ai .lai-btn.lai-primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }
  local-ai .lai-btn.lai-primary:hover {
    background: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
  }
  local-ai .lai-btn.lai-block { width: 100%; }
  local-ai .lai-btn.lai-sm {
    padding: 0.38rem 0.7rem;
    font-size: 0.8rem;
    border-radius: 8px;
  }
  local-ai .lai-btn.lai-danger { color: var(--aig-danger-text); }
  local-ai .lai-btn.lai-danger:hover { background: var(--aig-danger-bg); }
  local-ai .lai-btn:disabled { opacity: 0.5; cursor: default; }

  /* Privacy footnote in consent */
  local-ai .lai-privacy {
    font-size: 0.78rem;
    color: var(--sl-color-gray-2);
    margin: 0;
  }
  local-ai .lai-privacy a {
    color: var(--sl-color-text-accent);
    text-underline-offset: 2px;
  }

  /* ---- Downloading view ------------------------------------ */
  local-ai .lai-dl {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 1.6rem;
    padding-bottom: 1.6rem;
    gap: 0;
    flex: 1;
  }

  local-ai .lai-ring {
    position: relative;
    width: 132px;
    height: 132px;
  }
  local-ai .lai-ring svg {
    transform: rotate(-90deg);
    width: 132px;
    height: 132px;
    display: block;
  }
  local-ai .lai-ring .lai-track { stroke: var(--sl-color-accent-low); }
  local-ai .lai-ring .lai-bar {
    stroke: var(--sl-color-accent);
    stroke-linecap: round;
  }
  local-ai .lai-pct-wrap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  local-ai .lai-pct {
    font-size: 1.7rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: var(--sl-color-text);
  }
  local-ai .lai-pct small {
    display: block;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    margin-top: 0.1rem;
  }
  local-ai .lai-dl-title {
    margin: 1.2rem 0 0.35rem;
    font-size: 1.05rem;
    color: var(--sl-color-text);
  }
  local-ai .lai-stage {
    margin: 0;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
    font-variant-numeric: tabular-nums;
    max-width: 100%;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  /* Fix 4: elapsed time — hidden until web-llm reports a value */
  local-ai .lai-elapsed:empty { display: none; }

  local-ai .lai-reassure {
    margin: 1rem 0 0;
    font-size: 0.76rem;
    color: var(--sl-color-gray-2);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    justify-content: center;
  }
  local-ai .lai-reassure .lai-ic {
    width: 15px;
    height: 15px;
  }

  /* Pulse animation for live stage text */
  @keyframes lai-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.45; }
  }
  local-ai .lai-live {
    animation: lai-pulse 1.6s ease-in-out infinite;
  }

  /* ---- Chat view ------------------------------------------- */
  local-ai .lai-msgs {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding-right: 2px;
  }

  local-ai .lai-bubble {
    max-width: 88%;
    padding: 0.6rem 0.8rem;
    border-radius: 14px;
    font-size: 0.9rem;
    line-height: 1.55;
    word-break: break-word;
  }
  /* User bubble */
  local-ai .lai-bubble.lai-u {
    align-self: flex-end;
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    border-bottom-right-radius: 5px;
  }
  /* Assistant bubble */
  local-ai .lai-bubble.lai-a {
    align-self: flex-start;
    background: var(--aig-elevated-bg-warm);
    border: 1px solid var(--sl-color-hairline);
    border-bottom-left-radius: 5px;
    white-space: pre-wrap;
  }
  local-ai .lai-bubble.lai-a p  { margin: 0 0 0.5rem; }
  local-ai .lai-bubble.lai-a p:last-child { margin-bottom: 0; }
  local-ai .lai-bubble.lai-a strong { font-weight: 700; }
  local-ai .lai-bubble.lai-a ul { margin: 0.2rem 0 0.5rem; padding-left: 1.1rem; }
  local-ai .lai-bubble.lai-a li { margin: 0.15rem 0; }
  local-ai .lai-bubble.lai-a code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.82em;
    background: var(--sl-color-accent-low);
    padding: 0.05em 0.32em;
    border-radius: 5px;
  }
  local-ai .lai-bubble.lai-a pre {
    margin: 0.4rem 0 0.2rem;
    background: var(--aig-code-bg);
    color: var(--aig-code-text);
    border-radius: 9px;
    padding: 0.6rem 0.7rem;
    overflow-x: auto;
  }
  local-ai .lai-bubble.lai-a pre code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.8rem;
    background: none;
    padding: 0;
    color: inherit;
  }

  /* Typing indicator */
  local-ai .lai-typing {
    align-self: flex-start;
    display: flex;
    gap: 4px;
    padding: 0.7rem 0.85rem;
    background: var(--aig-elevated-bg-warm);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 14px;
    border-bottom-left-radius: 5px;
  }
  local-ai .lai-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #9A93AC; /* muted, intentional status color */
    display: block;
    animation: lai-blink 1.2s infinite;
    font-style: normal;
  }
