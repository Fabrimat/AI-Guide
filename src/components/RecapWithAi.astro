---
/**
 * RecapWithAi: trasforma la tua IA in un tutor sulle lezioni che hai
 * effettivamente letto.
 *
 * Legge `localStorage` (chiave `aiguide:progress:v1`, popolata da
 * `src/scripts/progress.ts`), trova le pagine lezione con `read: true`,
 * e al click di "Genera prompt di ripasso" assembla un prompt che
 * istruisce l'IA a fare ripasso socratico SU QUELLE lezioni. Il prompt
 * viene mostrato in un `<dialog>` con bottone copia.
 *
 * Se l'utente non ha ancora completato nessuna lezione, il bottone è
 * disabilitato e la card mostra una riga di stato che lo spiega.
 *
 * Il prompt include, per ogni lezione letta, il riassunto preso da
 * `/recap/<locale>.json` (generato a build time dai `<LessonSummary>`),
 * una riga di livello dedotta dal `livello` delle lezioni e gli appunti
 * del diario (`aiguide:journal:v1`) se presenti. Logica condivisa con
 * `<ReviewToday>` in `src/scripts/recap-prompt.ts`.
 *
 * Da posizionare su pagine di orientamento (homepage, `start-here`) e
 * a fine modulo. Niente prop, si include come `<RecapWithAi />`.
 */
import Glyph from './Glyph.astro';
import { t } from '../i18n/ui';
import { promptAttrs } from '../scripts/recap-prompt';
const ui = t(Astro.currentLocale);
// Per-instance id suffix: several cards can live on the same page.
const uid = Math.random().toString(36).slice(2, 8);
const titleId = `recap-dialog-title-${uid}`;
---

<div
  class="recap-with-ai not-content"
  data-recap
  data-i18n-empty={ui.recapEmpty}
  data-i18n-count-one={ui.recapCountOne}
  data-i18n-count-many-template={ui.recapCountMany(0).replace('0', '__N__')}
  data-i18n-copied={ui.recapCopied}
  data-i18n-copy={ui.recapCopy}
  data-i18n-error={ui.recapCopyError}
  {...promptAttrs(ui)}
  hidden
>
  <header>
    <span class="recap-badge"><Glyph name="graduation-cap" /> {ui.recapBadge}</span>
    <h3>{ui.recapTitle}</h3>
  </header>

  <p class="recap-desc">{ui.recapDesc}</p>

  <p class="recap-status" data-recap-status></p>

  <div class="recap-actions">
    <button type="button" class="recap-btn" data-recap-generate>
      {ui.recapGenerate}
    </button>
  </div>

  <dialog
    class="recap-dialog"
    data-recap-dialog
    aria-labelledby={titleId}
  >
    <h4 id={titleId}>{ui.recapDialogTitle}</h4>
    <p class="recap-dialog-hint">{ui.recapDialogHint}</p>
    <pre class="recap-output" data-recap-output></pre>
    <div class="recap-dialog-actions">
      <button
        type="button"
        class="recap-btn recap-btn-primary"
        data-recap-copy
        aria-live="polite"
      >
        {ui.recapCopy}
      </button>
      <button
        type="button"
        class="recap-btn recap-btn-ghost"
        data-recap-close
      >
        {ui.recapClose}
      </button>
    </div>
  </dialog>
</div>

<script>
  import { track } from '../scripts/analytics';
  import {
    buildRecapPrompt,
    detectCurrentLocale,
    fetchRecapData,
    loadReadLessons,
    readPromptStrings,
  } from '../scripts/recap-prompt';

  function applyState(root: HTMLElement) {
    const lessons = loadReadLessons();
    const status = root.querySelector<HTMLElement>('[data-recap-status]');
    const btn = root.querySelector<HTMLButtonElement>('[data-recap-generate]');
    if (!status || !btn) return;

    if (lessons.length === 0) {
      status.textContent = root.dataset.i18nEmpty || '';
      btn.disabled = true;
    } else if (lessons.length === 1) {
      status.textContent = root.dataset.i18nCountOne || '';
      btn.disabled = false;
    } else {
      const template = root.dataset.i18nCountManyTemplate || '';
      status.textContent = template.replace('__N__', String(lessons.length));
      btn.disabled = false;
    }

    root.removeAttribute('hidden');
  }

  function wire(root: HTMLElement) {
    const generateBtn = root.querySelector<HTMLButtonElement>(
      '[data-recap-generate]',
    );
    const dialog = root.querySelector<HTMLDialogElement>('[data-recap-dialog]');
    const output = root.querySelector<HTMLElement>('[data-recap-output]');
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-recap-copy]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-recap-close]');

    if (!generateBtn || !dialog || !output || !copyBtn || !closeBtn) return;

    generateBtn.addEventListener('click', async () => {
      const lessons = loadReadLessons();
      if (lessons.length === 0) return;
      track('recap_generate', { lessons: lessons.length });
      generateBtn.disabled = true;
      // Summaries come from the build-time JSON; if the fetch fails the
      // prompt falls back to titles only.
      const data = await fetchRecapData(detectCurrentLocale() || 'en');
      generateBtn.disabled = false;
      output.textContent = buildRecapPrompt(readPromptStrings(root), lessons, data);
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      }
    });

    closeBtn.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    copyBtn.addEventListener('click', async () => {
      const text = output.textContent || '';
      if (!text) return;
      // Salva l'etichetta originale una volta sola: con click ripetuti
      // entro il timeout `textContent` sarebbe già "Copiato!".
      const original = (copyBtn.dataset.label ??= copyBtn.textContent ?? '');
      const copied = root.dataset.i18nCopied || '';
      const error = root.dataset.i18nError || '';
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = copied;
      } catch {
        copyBtn.textContent = error;
      }
      window.setTimeout(() => {
        copyBtn.textContent = original;
      }, 2000);
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-recap]').forEach((root) => {
      if (root.dataset.recapWired !== 'true') {
        root.dataset.recapWired = 'true';
        wire(root);
      }
      applyState(root);
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
  // Quando l'utente clicca "Cancella progressi" nel widget Resume, il
  // conteggio torna a zero: aggiorniamo la card subito.
  window.addEventListener('aiguide:progress-cleared', () => {
    document.querySelectorAll<HTMLElement>('[data-recap]').forEach(applyState);
  });
</script>

<style>
  /* Foglietto di carta sulla quadrettatura: bordo a penna, ombra dura,
     badge scritto a mano. */
  .recap-with-ai {
    margin: 1.75rem auto;
    padding: 1.25rem 1.25rem 1rem;
    max-width: 900px;
    background: var(--aig-elevated-bg);
    border: var(--aig-border-width) solid var(--sl-color-hairline-shade);
    border-radius: var(--aig-radius);
    box-shadow: var(--aig-shadow-hard);
  }

  .recap-with-ai[hidden] {
    display: none;
  }

  .recap-with-ai header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.4rem;
  }

  .recap-badge {
    font-family: var(--aig-font-hand);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--aig-ink);
  }

  .recap-with-ai h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 750;
    color: var(--aig-heading);
    letter-spacing: -0.01em;
  }

  .recap-desc {
    margin: 0.25rem 0 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .recap-status {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }

  .recap-actions {
    display: flex;
    gap: 0.5rem;
  }

  .recap-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 1.1rem;
    border-radius: var(--aig-radius);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: var(--aig-border-width) solid var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--aig-on-accent);
  }

  .recap-btn:hover:not(:disabled) {
    background: var(--aig-accent-hover);
    border-color: var(--aig-accent-hover);
  }

  .recap-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .recap-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .recap-dialog {
    margin: auto;
    padding: 1.5rem;
    max-width: 36rem;
    width: calc(100% - 2rem);
    background: var(--aig-elevated-bg);
    color: var(--sl-color-text);
    border: var(--aig-border-width) solid var(--sl-color-hairline-shade);
    border-radius: var(--aig-radius);
    box-shadow: var(--aig-shadow-hard);
    font-family: var(--sl-font);
  }

  .recap-dialog::backdrop {
    background: var(--aig-scrim);
  }

  .recap-dialog h4 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 750;
    color: var(--aig-heading);
    letter-spacing: -0.01em;
  }

  .recap-dialog-hint {
    margin: 0 0 1rem;
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Anteprima del prompt: un cartellino di carta. */
  .recap-output {
    margin: 0 0 1rem;
    padding: 0.75rem 0.85rem;
    background: var(--aig-elevated-bg-warm);
    border: var(--aig-border-width) solid var(--sl-color-hairline-shade);
    border-radius: var(--aig-radius);
    font-family: var(--sl-font);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--sl-color-text);
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 50vh;
    overflow-y: auto;
  }

  .recap-dialog-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .recap-btn-ghost {
    background: transparent;
    color: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
  }

  .recap-btn-ghost:hover:not(:disabled) {
    background: var(--aig-hover-wash);
    border-color: var(--sl-color-accent);
  }
</style>
