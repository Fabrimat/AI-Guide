---
/**
 * Def: termine inline cliccabile con una breve spiegazione in popover.
 *
 * Pattern familiare del dizionario/enciclopedia: la parola è evidenziata
 * con una sottolineatura tratteggiata biro (stesso colore dei link nel
 * corpo testo), al passaggio del mouse o click compare un popover con
 * la definizione.
 *
 * API minimale: l'autore passa la spiegazione come prop `explanation`
 * (stringa) e il termine come child. Per definizioni più articolate o
 * con link, estendere in futuro con uno slot dedicato.
 *
 * Comportamento:
 *  - hover (solo dispositivi con `@media (hover: hover)`): popover via CSS
 *    :hover. Sui dispositivi touch il hover non apre nulla, così un tap
 *    non lascia un popover "incollato".
 *  - click / tap: toggle `is-open`, persiste finché l'utente clicca
 *    fuori o preme Escape. Un secondo tap lo chiude.
 *  - focus da tastiera: popover via `:focus-visible`, accessibile.
 *  - Escape chiude anche il popover aperto da hover o focus (classe
 *    `is-dismissed`, tolta quando il puntatore esce o il focus si sposta):
 *    WCAG 1.4.13.
 *  - su schermi stretti il popover viene spostato in orizzontale (variabile
 *    `--def-shift`) per restare dentro la viewport.
 *
 * A11y: il termine è reso come `<button>` (nativamente focusable e
 * keyboard-friendly), con `aria-expanded` e `aria-describedby` che
 * collega al popover (`role="tooltip"`).
 */
interface Props {
  explanation: string;
}

const { explanation } = Astro.props;

// Id univoco per istanza per `aria-describedby` (più <Def> sulla stessa
// pagina non devono mai condividere l'id). Non serve determinismo
// cross-build perché l'associazione vive solo dentro la stessa pagina.
const popoverId = `def-${crypto.randomUUID().replace(/-/g, '').slice(0, 12)}`;
---

<span class="def-wrap" data-def-wrap>
  <button
    type="button"
    class="def-term"
    aria-expanded="false"
    aria-describedby={popoverId}
    data-def-term
  >
    <slot />
  </button>
  <span class="def-pop" id={popoverId} role="tooltip">
    {explanation}
  </span>
</span>

<script>
  function wireLocalButtons() {
    const wraps = document.querySelectorAll<HTMLElement>('[data-def-wrap]');
    wraps.forEach((wrap) => {
      if (wrap.dataset.defWired === 'true') return;
      wrap.dataset.defWired = 'true';
      const btn = wrap.querySelector<HTMLButtonElement>('[data-def-term]');
      if (!btn) return;

      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        const willOpen = !wrap.classList.contains('is-open');
        closeAll();
        if (willOpen) {
          wrap.classList.remove('is-dismissed');
          wrap.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          position(wrap);
        } else {
          // Keep it closed even while the pointer still hovers the term.
          wrap.classList.add('is-dismissed');
        }
      });

      // Hover / keyboard focus open the popover via CSS: here we only
      // re-arm after an Escape and keep the popover inside the viewport.
      wrap.addEventListener('mouseenter', () => position(wrap));
      wrap.addEventListener('mouseleave', () => wrap.classList.remove('is-dismissed'));
      btn.addEventListener('focus', () => position(wrap));
      btn.addEventListener('blur', () => wrap.classList.remove('is-dismissed'));
    });
  }

  function closeAll() {
    document
      .querySelectorAll<HTMLElement>('[data-def-wrap].is-open')
      .forEach((wrap) => {
        wrap.classList.remove('is-open');
        const btn = wrap.querySelector<HTMLButtonElement>('[data-def-term]');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
  }

  // Escape: close everything, including popovers opened by hover/focus.
  function dismissAll() {
    document.querySelectorAll<HTMLElement>('[data-def-wrap]').forEach((wrap) => {
      const shown =
        wrap.classList.contains('is-open') ||
        wrap.matches(':hover') ||
        wrap.querySelector('[data-def-term]:focus-visible') !== null;
      if (shown) wrap.classList.add('is-dismissed');
    });
    closeAll();
  }

  // Shift the popover horizontally so it stays inside the viewport.
  function position(wrap: HTMLElement) {
    const pop = wrap.querySelector<HTMLElement>('.def-pop');
    if (!pop) return;
    pop.style.setProperty('--def-shift', '0px');
    const margin = 8;
    const vw = document.documentElement.clientWidth;
    const rect = pop.getBoundingClientRect();
    if (rect.width === 0) return; // not displayed
    let shift = 0;
    if (rect.right > vw - margin) shift = vw - margin - rect.right;
    if (rect.left + shift < margin) shift = margin - rect.left;
    pop.style.setProperty('--def-shift', `${Math.round(shift)}px`);
  }

  // I listener globali vanno attaccati una sola volta per sessione,
  // anche attraverso le view transitions di Astro.
  const marker = '__aiguideDefGlobalsWired';
  if (!(window as unknown as Record<string, unknown>)[marker]) {
    (window as unknown as Record<string, unknown>)[marker] = true;

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('[data-def-wrap]')) {
        return;
      }
      closeAll();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') dismissAll();
    });
  }

  wireLocalButtons();
  document.addEventListener('astro:page-load', wireLocalButtons);
</script>

<style>
  .def-wrap {
    position: relative;
    display: inline-block;
  }

  .def-term {
    /* Reset degli stili di default del button. */
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    line-height: inherit;

    color: inherit;
    cursor: help;
    text-decoration: underline dashed var(--aig-ink);
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    border-radius: 2px;
  }

  /* Highlighter wash when hovered, focused or open. */
  .def-term:hover,
  .def-wrap.is-open .def-term {
    background-color: var(--aig-highlighter-wash);
  }

  .def-term:focus-visible {
    outline: 2px solid var(--aig-ink);
    outline-offset: 2px;
    background-color: var(--aig-highlighter-wash);
  }

  .def-pop {
    position: absolute;
    top: calc(100% + 8px);
    left: var(--def-shift, 0px);
    z-index: 20;

    min-width: 180px;
    max-width: min(280px, calc(100vw - 2rem));
    padding: 0.6rem 0.75rem;

    background: var(--aig-elevated-bg);
    border: var(--aig-border-width) solid var(--aig-ink);
    border-radius: var(--aig-radius);
    box-shadow: var(--aig-shadow-hard);

    color: var(--sl-color-text);
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    white-space: normal;

    /* Hidden via `display: none`, non `visibility: hidden`: un popover
       invisible-but-laid-out da 280px sporgerebbe oltre la viewport
       ogni volta che il termine <Def> è a metà/destra della riga,
       generando scroll orizzontale su mobile (e spingendo fuori dal
       canvas il bottone fisso del menu di Starlight).
       `transition-behavior: allow-discrete` + `@starting-style` nella
       regola "aperto" tengono il fade sui browser moderni; sui più
       vecchi il popover compare senza animazione, accettabile. */
    display: none;
    opacity: 0;
    transform: translateY(-2px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      display 0.15s allow-discrete;
  }

  /* Piccolo arrow in alto a sinistra. */
  .def-pop::before {
    content: '';
    position: absolute;
    top: -5px;
    /* Counter the horizontal shift so the arrow still points at the term. */
    left: clamp(0.5rem, calc(1rem - var(--def-shift, 0px)), calc(100% - 1.5rem));
    width: 10px;
    height: 10px;
    background: var(--aig-elevated-bg);
    border-left: var(--aig-border-width) solid var(--aig-ink);
    border-top: var(--aig-border-width) solid var(--aig-ink);
    transform: rotate(45deg);
  }

  /* Hover opens only on devices that really hover: on touch a tap would
     otherwise leave a sticky :hover and the second tap could not close. */
  @media (hover: hover) {
    .def-wrap:hover .def-pop {
      display: block;
      opacity: 1;
      transform: translateY(0);

      @starting-style {
        opacity: 0;
        transform: translateY(-2px);
      }
    }
  }

  .def-wrap.is-open .def-pop,
  .def-wrap:has(:where(.def-term:focus-visible)) .def-pop {
    display: block;
    opacity: 1;
    transform: translateY(0);

    /* `@starting-style` definisce lo stato di partenza quando si passa
       da display:none a display:block: senza, il browser applicherebbe
       subito lo stato finale e la transition non partirebbe. */
    @starting-style {
      opacity: 0;
      transform: translateY(-2px);
    }
  }

  /* Escape / second click: wins over hover, focus and is-open
     (WCAG 1.4.13, dismissable). Cleared on pointer leave / blur. */
  .def-wrap.is-dismissed .def-pop {
    display: none;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .def-pop {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .def-pop {
      max-width: calc(100vw - 1.5rem);
    }
  }
</style>
