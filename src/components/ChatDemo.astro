---
/**
 * ChatDemo: esempio animato di una conversazione fra utente e IA.
 *
 * Sostituisce le GIF "finte conversazioni". L'utente fittizio scrive il
 * proprio messaggio a macchina (typewriter), c'è una breve pausa di
 * "pensiero" lato IA (dots animati), poi l'IA risponde a macchina.
 *
 * La risposta IA supporta un sottoinsieme di markdown inline:
 * **grassetto**, *corsivo*, `codice`, [link](url). Il rendering avviene
 * a build time (Astro SSR). Il typewriter resta fluido perché cammina i
 * nodi di testo del DOM già renderizzato, rivelandoli progressivamente
 * senza rompere i tag.
 *
 * Uso in una pagina .mdx:
 *
 *   <ChatDemo
 *     user="Spiegami i buchi neri in due frasi"
 *     ai={`Un **buco nero** è una regione dello spaziotempo dove la gravità
 *     è così forte che nulla, nemmeno la luce, può sfuggire.
 *
 *     Si forma quando una stella molto massiccia collassa su se stessa.`}
 *   />
 *
 * ## Accessibilità: niente layout shift
 *
 * Ogni bolla e il contenitore intero hanno la dimensione finale fin dal
 * primo render. Tecnicamente: in ogni bolla c'è un "ghost" (`text-ghost`)
 * con il testo completo, reso invisibile via `color: transparent`, in
 * grid stacking con il layer visibile. Il ghost riserva lo spazio; il
 * layer visibile ci scrive sopra il typewriter senza far cambiare le
 * dimensioni del contenitore.
 *
 * Il ghost resta accessibile agli screen reader (mentre il layer visibile
 * animato è marcato `aria-hidden`), così l'utente SR riceve la
 * conversazione completa una volta sola.
 *
 *  - `prefers-reduced-motion: reduce` -> render statico, zero animazione.
 *  - Senza JS                         -> render statico (HTML iniziale è
 *                                        già lo stato finale).
 *  - `IntersectionObserver`           -> l'animazione parte solo quando
 *                                        il componente entra in viewport.
 */
export interface Props {
  user: string;
  ai: string;
  typingSpeed?: number;
  thinkingTime?: number;
  autoPlay?: boolean;
  loop?: boolean;
  loopDelay?: number;
  userLabel?: string;
  aiLabel?: string;
  showReplay?: boolean;
}

import { t } from '../i18n/ui';
const ui = t(Astro.currentLocale);

const {
  user,
  ai,
  typingSpeed = 28,
  thinkingTime = 900,
  autoPlay = true,
  loop = false,
  loopDelay = 3500,
  userLabel = ui.chatUserLabel,
  aiLabel = ui.chatAiLabel,
  showReplay = true,
} = Astro.props;

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

/**
 * Sottoinsieme sicuro di markdown inline per la risposta IA.
 *
 * Supportato:
 *   **grassetto** / __grassetto__
 *   *corsivo* / _corsivo_
 *   `codice`
 *   [testo](url)  (solo http/https/mailto, oppure path/ancora relativi)
 *
 * Non supporta blocchi (heading, liste, blockquote): il testo fuori dalle
 * regole inline resta plain, i newline sono preservati via
 * `white-space: pre-wrap` nel CSS. I caratteri markdown inline che non
 * matchano una regola restano visibili come caratteri normali.
 *
 * Il testo è escapato di HTML come primo passo, quindi niente injection
 * anche se l'autore scrive <script> nella stringa `ai`.
 */
function renderInlineMarkdown(src: string): string {
  let out = escapeHtml(src);

  // Code inline per primo, protetto via placeholder ASCII multi-carattere
  // che non può apparire in testo di lezione (@@AIG_CODE_N@@).
  const codes: string[] = [];
  out = out.replace(/`([^`\n]+)`/g, (_, inner) => {
    const idx = codes.push(inner) - 1;
    return `@@AIG_CODE_${idx}@@`;
  });

  // Link [testo](url). Solo schemi sicuri; altrimenti fallback a "#".
  out = out.replace(/\[([^\]\n]+?)\]\(([^)\s]+?)\)/g, (_, text, url) => {
    const safe = /^(https?:\/\/|mailto:|\/|#)/i.test(url) ? url : '#';
    return `<a href="${safe}" rel="noreferrer">${text}</a>`;
  });

  // Grassetto prima del corsivo, così **x** non diventa <em>*x*</em>.
  out = out.replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>');
  out = out.replace(/__([^_\n]+?)__/g, '<strong>$1</strong>');

  // Corsivo. Evita word-boundary (file_name non diventa file<em>name</em>)
  // e collisioni con i marker del grassetto già consumati.
  out = out.replace(/(^|[^*\w])\*([^*\n]+?)\*(?!\w)/g, '$1<em>$2</em>');
  out = out.replace(/(^|[^_\w])_([^_\n]+?)_(?!\w)/g, '$1<em>$2</em>');

  // Ripristina il codice inline.
  out = out.replace(/@@AIG_CODE_(\d+)@@/g, (_, idx) => {
    return `<code>${codes[Number(idx)]}</code>`;
  });

  return out;
}

const aiHtml = renderInlineMarkdown(ai);
---

<figure
  class="chat-demo not-content"
  data-user-text={user}
  data-typing-speed={typingSpeed}
  data-thinking-time={thinkingTime}
  data-autoplay={String(autoPlay)}
  data-loop={String(loop)}
  data-loop-delay={loopDelay}
  role="group"
  aria-label={ui.chatExampleAria(user.slice(0, 80))}
>
  <div class="chat-stage">
    <div class="message message-user" data-role="user">
      <div class="avatar" aria-hidden="true">👤</div>
      <div class="bubble">
        <div class="label">{userLabel}</div>
        <div class="text">
          <span class="text-ghost">{user}</span>
          <span class="text-visible" aria-hidden="true"><span class="text-content">{user}</span><span class="caret"></span></span>
        </div>
      </div>
    </div>

    <div class="message message-ai" data-role="ai">
      <div class="avatar" aria-hidden="true">🤖</div>
      <div class="bubble">
        <div class="label">{aiLabel}</div>
        <div class="text">
          <span class="text-ghost" set:html={aiHtml}></span>
          <span class="text-visible" aria-hidden="true"><span class="thinking" data-thinking><span class="dot"></span><span class="dot"></span><span class="dot"></span></span><span class="text-content" set:html={aiHtml}></span><span class="caret"></span></span>
        </div>
      </div>
    </div>
  </div>

  {showReplay && (
    <div class="chat-controls">
      <button type="button" class="chat-btn btn-skip" data-action="skip" aria-label={ui.chatSkipAria} hidden>
        {ui.chatSkip}
      </button>
      <button type="button" class="chat-btn btn-replay" data-action="replay" aria-label={ui.chatReplayAria}>
        {ui.chatReplay}
      </button>
    </div>
  )}
</figure>

<script>
  /**
   * Span di testo sotto il DOM IA. Cachiamo il contenuto originale dei
   * text node al primo accesso (quando il DOM è ancora lo stato finale
   * del SSR). Poi li svuotiamo e li riempiamo progressivamente durante
   * il typewriter, lasciando intatta la struttura dei tag markdown.
   */
  interface AiTextSpan {
    node: Text;
    fullText: string;
  }

  class ChatDemoPlayer {
    el: HTMLElement;
    typingSpeed: number;
    thinkingTime: number;
    autoPlay: boolean;
    loop: boolean;
    loopDelay: number;
    userMsg: HTMLElement;
    aiMsg: HTMLElement;
    userText: string;
    aiSpans: AiTextSpan[] = [];
    aiTotalChars = 0;
    replayBtn: HTMLButtonElement | null;
    skipBtn: HTMLButtonElement | null;
    running = false;
    cancelled = false;
    reducedMotion: boolean;
    observer: IntersectionObserver | null = null;

    constructor(el: HTMLElement) {
      this.el = el;
      this.typingSpeed = parseInt(el.dataset.typingSpeed || '28', 10);
      this.thinkingTime = parseInt(el.dataset.thinkingTime || '900', 10);
      this.autoPlay = el.dataset.autoplay === 'true';
      this.loop = el.dataset.loop === 'true';
      this.loopDelay = parseInt(el.dataset.loopDelay || '3500', 10);
      this.userText = el.dataset.userText || '';
      this.userMsg = el.querySelector('[data-role="user"]') as HTMLElement;
      this.aiMsg = el.querySelector('[data-role="ai"]') as HTMLElement;
      this.replayBtn = el.querySelector('[data-action="replay"]') as HTMLButtonElement | null;
      this.skipBtn = el.querySelector('[data-action="skip"]') as HTMLButtonElement | null;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Snapshot dei text node IA prima di toccare qualunque cosa: qui
      // il DOM è ancora lo stato finale del SSR.
      this.collectAiSpans();

      this.replayBtn?.addEventListener('click', () => this.replay());
      this.skipBtn?.addEventListener('click', () => this.skip());

      // Segnala al CSS che JS è attivo: da qui in poi gestiamo noi
      // contenuto visibile, dots e caret. Senza questa classe il
      // componente resta in stato statico (HTML iniziale = stato finale).
      el.classList.add('is-enhanced');

      if (this.reducedMotion) {
        this.renderStatic();
        return;
      }

      this.prime();

      if (this.autoPlay) {
        this.observe();
      }
    }

    collectAiSpans() {
      const aiContent = this.aiMsg.querySelector('.text-content') as HTMLElement;
      const walker = document.createTreeWalker(aiContent, NodeFilter.SHOW_TEXT);
      let node: Node | null;
      while ((node = walker.nextNode())) {
        const txt = (node as Text).textContent ?? '';
        if (txt.length === 0) continue;
        this.aiSpans.push({ node: node as Text, fullText: txt });
      }
      this.aiTotalChars = this.aiSpans.reduce((sum, s) => sum + s.fullText.length, 0);
    }

    /**
     * Stato iniziale dell'animazione. NON tocca le dimensioni:
     * il ghost resta a riservare lo spazio, cambiamo solo il layer
     * visibile (svuotiamo il testo, mostriamo i dots dell'IA, nascondiamo i caret).
     */
    prime() {
      const userContent = this.userMsg.querySelector('.text-content') as HTMLElement;
      const userCaret = this.userMsg.querySelector('.caret') as HTMLElement;
      const aiCaret = this.aiMsg.querySelector('.caret') as HTMLElement;
      const aiThinking = this.aiMsg.querySelector('[data-thinking]') as HTMLElement;

      userContent.textContent = '';
      userCaret.classList.remove('is-active');
      for (const span of this.aiSpans) span.node.textContent = '';
      aiCaret.classList.remove('is-active');
      aiThinking.classList.remove('is-hidden');
    }

    observe() {
      this.observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              this.observer?.disconnect();
              this.observer = null;
              void this.play();
            }
          }
        },
        { threshold: 0.35 },
      );
      this.observer.observe(this.el);
    }

    async play() {
      if (this.running) return;
      this.running = true;
      this.cancelled = false;
      this.setSkipVisible(true);

      this.prime();

      // Piccolo delay per dare percezione del "before" stabile.
      await this.sleep(180);
      if (this.cancelled) return this.finish();

      // 1. Typewriter sul messaggio utente (con caret attivo).
      const userContent = this.userMsg.querySelector('.text-content') as HTMLElement;
      const userCaret = this.userMsg.querySelector('.caret') as HTMLElement;
      userCaret.classList.add('is-active');
      await this.typeUser(userContent, this.userText);
      if (this.cancelled) return this.finish();
      userCaret.classList.remove('is-active');

      // 2. Pausa breve: messaggio "inviato".
      await this.sleep(380);
      if (this.cancelled) return this.finish();

      // 3. Pausa "thinking": i dots dell'IA continuano ad animarsi.
      await this.sleep(this.thinkingTime);
      if (this.cancelled) return this.finish();

      // 4. Nascondi i dots, abilita caret IA, typewriter sulla risposta.
      const aiCaret = this.aiMsg.querySelector('.caret') as HTMLElement;
      const aiThinking = this.aiMsg.querySelector('[data-thinking]') as HTMLElement;
      aiThinking.classList.add('is-hidden');
      aiCaret.classList.add('is-active');
      await this.typeAi();
      if (this.cancelled) return this.finish();
      aiCaret.classList.remove('is-active');

      this.running = false;
      this.setSkipVisible(false);

      if (this.loop && !this.cancelled) {
        await this.sleep(this.loopDelay);
        if (!this.cancelled) void this.play();
      }
    }

    finish() {
      this.running = false;
      this.setSkipVisible(false);
    }

    /**
     * Salta all'istante allo stato finale. Cancella l'animazione in corso
     * e rende statico il DOM, così l'utente non deve aspettare la fine
     * del typewriter per vedere il messaggio dell'IA. Il bottone Replay
     * resta disponibile per riavviare.
     */
    skip() {
      if (!this.running) return;
      this.cancelled = true;
      this.running = false;
      this.renderStatic();
      this.setSkipVisible(false);
    }

    setSkipVisible(visible: boolean) {
      if (!this.skipBtn) return;
      this.skipBtn.hidden = !visible;
    }

    async typeUser(el: HTMLElement, text: string) {
      el.textContent = '';
      for (let i = 0; i < text.length; i++) {
        if (this.cancelled) return;
        el.textContent = text.slice(0, i + 1);
        await this.sleep(this.typingSpeed);
      }
    }

    /**
     * Typewriter IA che cammina i text node cacheati. Ad ogni tick
     * avanza di un carattere globale e distribuisce il totale sui nodi
     * in ordine: nodi pienamente rivelati mantengono il loro testo,
     * il nodo corrente è troncato al carattere giusto, quelli dopo
     * restano vuoti. I tag di mezzo (strong, em, a, code) restano al
     * loro posto, solo il loro contenuto testuale appare a poco a poco.
     */
    async typeAi() {
      for (let i = 1; i <= this.aiTotalChars; i++) {
        if (this.cancelled) return;
        this.revealAi(i);
        await this.sleep(this.typingSpeed);
      }
    }

    revealAi(count: number) {
      let remaining = count;
      for (const span of this.aiSpans) {
        const len = span.fullText.length;
        if (remaining <= 0) {
          span.node.textContent = '';
          continue;
        }
        if (remaining >= len) {
          span.node.textContent = span.fullText;
          remaining -= len;
        } else {
          span.node.textContent = span.fullText.slice(0, remaining);
          remaining = 0;
        }
      }
    }

    /** Stato finale senza animazione (reduced motion / replay-finale). */
    renderStatic() {
      const userContent = this.userMsg.querySelector('.text-content') as HTMLElement;
      const userCaret = this.userMsg.querySelector('.caret') as HTMLElement;
      const aiCaret = this.aiMsg.querySelector('.caret') as HTMLElement;
      const aiThinking = this.aiMsg.querySelector('[data-thinking]') as HTMLElement;

      userContent.textContent = this.userText;
      userCaret.classList.remove('is-active');
      for (const span of this.aiSpans) span.node.textContent = span.fullText;
      aiCaret.classList.remove('is-active');
      aiThinking.classList.add('is-hidden');
    }

    replay() {
      this.cancelled = true;
      window.setTimeout(() => {
        this.cancelled = false;
        this.running = false;
        if (this.reducedMotion) {
          this.renderStatic();
        } else {
          void this.play();
        }
      }, 60);
    }

    sleep(ms: number): Promise<void> {
      return new Promise((resolve) => {
        window.setTimeout(resolve, ms);
      });
    }
  }

  const initialized = new WeakSet<HTMLElement>();

  function init() {
    document.querySelectorAll<HTMLElement>('.chat-demo').forEach((el) => {
      if (initialized.has(el)) return;
      initialized.add(el);
      new ChatDemoPlayer(el);
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .chat-demo {
    margin: 1.75rem 0;
    padding: 1rem 1rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.85rem;
    background: var(--sl-color-bg-nav, var(--sl-color-bg));
    font-family: var(--sl-font);
  }

  .chat-stage {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .message {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .message-user {
    flex-direction: row-reverse;
  }

  .avatar {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--sl-color-gray-6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    user-select: none;
  }

  .message-user .avatar {
    background: var(--sl-color-accent-low);
  }

  .bubble {
    max-width: min(78%, 520px);
    padding: 0.55rem 0.85rem;
    border-radius: 0.9rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .message-user .bubble {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert, #fff);
    border-bottom-right-radius: 0.25rem;
  }

  .message-ai .bubble {
    border-bottom-left-radius: 0.25rem;
  }

  .label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.7;
    margin-bottom: 0.2rem;
  }

  /* ----- Stacking ghost + visible nello stesso grid cell -----
     Il ghost ha il testo completo (resta a riservare lo spazio) ma è
     visivamente trasparente. Il layer visibile ci scrive sopra. Risultato:
     la bolla ha sempre la dimensione finale, indipendentemente dalla
     porzione di testo che è stata "digitata". */
  .text {
    display: grid;
    grid-template-areas: 'stack';
    line-height: 1.5;
    word-break: break-word;
  }

  .text > * {
    grid-area: stack;
    min-width: 0;
  }

  .text-ghost {
    color: transparent;
    user-select: none;
    pointer-events: none;
    white-space: pre-wrap;
    /* `visibility: visible` esplicito così resta accessibile a screen reader.
       (color: transparent non lo rimuove dall'accessibility tree.) */
    visibility: visible;
  }

  .text-visible {
    white-space: pre-wrap;
  }

  .text-content {
    /* Vuoto fino a quando JS non scrive il typewriter. Senza JS resta
       valorizzato dal SSR (= stato finale visibile). */
  }

  /* ----- Elementi markdown inline dentro la bolla IA ----- */
  .message-ai .text-content strong,
  .message-ai .text-ghost strong {
    font-weight: 700;
  }

  .message-ai .text-content em,
  .message-ai .text-ghost em {
    font-style: italic;
  }

  .message-ai .text-content code,
  .message-ai .text-ghost code {
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.88em;
    padding: 0.05em 0.3em;
    border-radius: 0.25em;
    background: var(--sl-color-gray-5);
  }

  /* Nel ghost il codice deve restare invisibile come tutto il resto del
     testo: serve solo a riservare lo spazio. La regola globale
     `.sl-markdown-content :not(pre) > code` in `custom.css` imposta un
     `color` e un `background` non-trasparenti su tutti i tag <code>; qui
     vinciamo per specificità e li riportiamo a trasparenti dentro il
     ghost. Senza questa regola le pillole `<code>` si vedono dal primo
     render e il typewriter non funziona più come "rivelazione progressiva
     del testo". */
  .message-ai .text-ghost code {
    color: transparent;
    background: transparent;
  }

  .message-ai .text-content a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .message-ai .text-ghost a {
    /* Il ghost eredita color: transparent, niente da fare qui. */
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ----- Caret blinking (visibile solo durante la digitazione) ----- */
  .caret {
    display: none;
    width: 0.55ch;
    height: 1em;
    margin-left: 1px;
    background: currentColor;
    vertical-align: text-bottom;
    opacity: 0.85;
  }

  .chat-demo.is-enhanced .caret.is-active {
    display: inline-block;
    animation: chat-demo-blink 900ms steps(2, start) infinite;
  }

  @keyframes chat-demo-blink {
    0%, 49% { opacity: 0.85; }
    50%, 100% { opacity: 0; }
  }

  /* ----- Thinking dots (visibili solo in modalità animata) ----- */
  .thinking {
    display: none;
    gap: 0.3rem;
    padding: 0.05rem 0;
    /* Inline-flex per non rompere il flow del text-content che segue. */
    vertical-align: middle;
  }

  .chat-demo.is-enhanced .thinking {
    display: inline-flex;
  }

  .chat-demo.is-enhanced .thinking.is-hidden {
    display: none;
  }

  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sl-color-gray-3);
    animation: chat-demo-dot 1200ms infinite ease-in-out;
  }

  .message-user .dot {
    background: var(--sl-color-text-invert, #fff);
    opacity: 0.8;
  }

  .dot:nth-child(2) { animation-delay: 150ms; }
  .dot:nth-child(3) { animation-delay: 300ms; }

  @keyframes chat-demo-dot {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.45; }
    30%           { transform: translateY(-0.28rem); opacity: 1; }
  }

  /* ----- Stato statico (no JS, no animazione) -----
     Senza .is-enhanced, il layer visibile mostra il SSR (testo completo),
     dots e caret restano nascosti. La bolla è alla dimensione finale. */
  .chat-demo:not(.is-enhanced) .caret {
    display: none;
  }

  .chat-demo:not(.is-enhanced) .thinking {
    display: none;
  }

  /* ----- Controlli ----- */
  .chat-controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.65rem;
  }

  .chat-btn {
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
    transition: background 120ms ease;
  }

  .chat-btn:hover {
    background: var(--sl-color-gray-6);
  }

  .chat-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret,
    .dot {
      animation: none;
    }
  }
</style>
