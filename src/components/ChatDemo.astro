---
/**
 * ChatDemo: esempio animato di una conversazione fra utente e IA.
 *
 * Sostituisce le GIF "finte conversazioni". L'utente fittizio scrive il
 * proprio messaggio a macchina (typewriter), c'è una breve pausa di
 * "pensiero" lato IA (dots animati), poi l'IA risponde a macchina.
 *
 * Uso in una pagina .mdx:
 *
 *   <ChatDemo
 *     user="Spiegami i buchi neri in due frasi"
 *     ai={`Un buco nero è una regione dello spaziotempo dove la gravità
 *     è così forte che nulla, nemmeno la luce, può sfuggire.
 *
 *     Si forma quando una stella molto massiccia collassa su se stessa.`}
 *   />
 *
 * ## Accessibilità: niente layout shift
 *
 * Ogni bolla e il contenitore intero hanno la dimensione finale fin dal
 * primo render. Tecnicamente: in ogni bolla c'è un "ghost" (`text-ghost`)
 * con il testo completo, reso invisibile via `color: transparent`, in
 * grid stacking con il layer visibile. Il ghost riserva lo spazio; il
 * layer visibile ci scrive sopra il typewriter senza far cambiare le
 * dimensioni del contenitore.
 *
 * Il ghost resta accessibile agli screen reader (mentre il layer visibile
 * animato è marcato `aria-hidden`), così l'utente SR riceve la
 * conversazione completa una volta sola.
 *
 *  - `prefers-reduced-motion: reduce` -> render statico, zero animazione.
 *  - Senza JS                         -> render statico (HTML iniziale è
 *                                        già lo stato finale).
 *  - `IntersectionObserver`           -> l'animazione parte solo quando
 *                                        il componente entra in viewport.
 */
export interface Props {
  user: string;
  ai: string;
  typingSpeed?: number;
  thinkingTime?: number;
  autoPlay?: boolean;
  loop?: boolean;
  loopDelay?: number;
  userLabel?: string;
  aiLabel?: string;
  showReplay?: boolean;
}

import { t } from '../i18n/ui';
const ui = t(Astro.currentLocale);

const {
  user,
  ai,
  typingSpeed = 28,
  thinkingTime = 900,
  autoPlay = true,
  loop = false,
  loopDelay = 3500,
  userLabel = ui.chatUserLabel,
  aiLabel = ui.chatAiLabel,
  showReplay = true,
} = Astro.props;
---

<figure
  class="chat-demo not-content"
  data-user-text={user}
  data-ai-text={ai}
  data-typing-speed={typingSpeed}
  data-thinking-time={thinkingTime}
  data-autoplay={String(autoPlay)}
  data-loop={String(loop)}
  data-loop-delay={loopDelay}
  role="group"
  aria-label={ui.chatExampleAria(user.slice(0, 80))}
>
  <div class="chat-stage">
    <div class="message message-user" data-role="user">
      <div class="avatar" aria-hidden="true">👤</div>
      <div class="bubble">
        <div class="label">{userLabel}</div>
        <div class="text">
          <span class="text-ghost">{user}</span>
          <span class="text-visible" aria-hidden="true">
            <span class="text-content">{user}</span><span class="caret"></span>
          </span>
        </div>
      </div>
    </div>

    <div class="message message-ai" data-role="ai">
      <div class="avatar" aria-hidden="true">🤖</div>
      <div class="bubble">
        <div class="label">{aiLabel}</div>
        <div class="text">
          <span class="text-ghost">{ai}</span>
          <span class="text-visible" aria-hidden="true">
            <span class="thinking" data-thinking>
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            </span>
            <span class="text-content">{ai}</span><span class="caret"></span>
          </span>
        </div>
      </div>
    </div>
  </div>

  {showReplay && (
    <div class="chat-controls">
      <button type="button" class="btn-replay" data-action="replay" aria-label={ui.chatReplayAria}>
        {ui.chatReplay}
      </button>
    </div>
  )}
</figure>

<script>
  class ChatDemoPlayer {
    el: HTMLElement;
    typingSpeed: number;
    thinkingTime: number;
    autoPlay: boolean;
    loop: boolean;
    loopDelay: number;
    userMsg: HTMLElement;
    aiMsg: HTMLElement;
    userText: string;
    aiText: string;
    replayBtn: HTMLButtonElement | null;
    running = false;
    cancelled = false;
    reducedMotion: boolean;
    observer: IntersectionObserver | null = null;

    constructor(el: HTMLElement) {
      this.el = el;
      this.typingSpeed = parseInt(el.dataset.typingSpeed || '28', 10);
      this.thinkingTime = parseInt(el.dataset.thinkingTime || '900', 10);
      this.autoPlay = el.dataset.autoplay === 'true';
      this.loop = el.dataset.loop === 'true';
      this.loopDelay = parseInt(el.dataset.loopDelay || '3500', 10);
      this.userText = el.dataset.userText || '';
      this.aiText = el.dataset.aiText || '';
      this.userMsg = el.querySelector('[data-role="user"]') as HTMLElement;
      this.aiMsg = el.querySelector('[data-role="ai"]') as HTMLElement;
      this.replayBtn = el.querySelector('[data-action="replay"]') as HTMLButtonElement | null;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.replayBtn?.addEventListener('click', () => this.replay());

      // Segnala al CSS che JS è attivo: da qui in poi gestiamo noi
      // contenuto visibile, dots e caret. Senza questa classe il
      // componente resta in stato statico (HTML iniziale = stato finale).
      el.classList.add('is-enhanced');

      if (this.reducedMotion) {
        this.renderStatic();
        return;
      }

      this.prime();

      if (this.autoPlay) {
        this.observe();
      }
    }

    /**
     * Stato iniziale dell'animazione. NON tocca le dimensioni:
     * il ghost resta a riservare lo spazio, cambiamo solo il layer
     * visibile (svuotiamo il testo, mostriamo i dots dell'IA, nascondiamo i caret).
     */
    prime() {
      const userContent = this.userMsg.querySelector('.text-content') as HTMLElement;
      const userCaret = this.userMsg.querySelector('.caret') as HTMLElement;
      const aiContent = this.aiMsg.querySelector('.text-content') as HTMLElement;
      const aiCaret = this.aiMsg.querySelector('.caret') as HTMLElement;
      const aiThinking = this.aiMsg.querySelector('[data-thinking]') as HTMLElement;

      userContent.textContent = '';
      userCaret.classList.remove('is-active');
      aiContent.textContent = '';
      aiCaret.classList.remove('is-active');
      aiThinking.classList.remove('is-hidden');
    }

    observe() {
      this.observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              this.observer?.disconnect();
              this.observer = null;
              void this.play();
            }
          }
        },
        { threshold: 0.35 },
      );
      this.observer.observe(this.el);
    }

    async play() {
      if (this.running) return;
      this.running = true;
      this.cancelled = false;

      this.prime();

      // Piccolo delay per dare percezione del "before" stabile.
      await this.sleep(180);
      if (this.cancelled) return this.finish();

      // 1. Typewriter sul messaggio utente (con caret attivo).
      const userContent = this.userMsg.querySelector('.text-content') as HTMLElement;
      const userCaret = this.userMsg.querySelector('.caret') as HTMLElement;
      userCaret.classList.add('is-active');
      await this.typeInto(userContent, this.userText);
      if (this.cancelled) return this.finish();
      userCaret.classList.remove('is-active');

      // 2. Pausa breve: messaggio "inviato".
      await this.sleep(380);
      if (this.cancelled) return this.finish();

      // 3. Pausa "thinking": i dots dell'IA continuano ad animarsi.
      await this.sleep(this.thinkingTime);
      if (this.cancelled) return this.finish();

      // 4. Nascondi i dots, abilita caret IA, typewriter sulla risposta.
      const aiContent = this.aiMsg.querySelector('.text-content') as HTMLElement;
      const aiCaret = this.aiMsg.querySelector('.caret') as HTMLElement;
      const aiThinking = this.aiMsg.querySelector('[data-thinking]') as HTMLElement;
      aiThinking.classList.add('is-hidden');
      aiCaret.classList.add('is-active');
      await this.typeInto(aiContent, this.aiText);
      if (this.cancelled) return this.finish();
      aiCaret.classList.remove('is-active');

      this.running = false;

      if (this.loop && !this.cancelled) {
        await this.sleep(this.loopDelay);
        if (!this.cancelled) void this.play();
      }
    }

    finish() {
      this.running = false;
    }

    async typeInto(el: HTMLElement, text: string) {
      el.textContent = '';
      for (let i = 0; i < text.length; i++) {
        if (this.cancelled) return;
        el.textContent = text.slice(0, i + 1);
        await this.sleep(this.typingSpeed);
      }
    }

    /** Stato finale senza animazione (reduced motion / replay-finale). */
    renderStatic() {
      const userContent = this.userMsg.querySelector('.text-content') as HTMLElement;
      const userCaret = this.userMsg.querySelector('.caret') as HTMLElement;
      const aiContent = this.aiMsg.querySelector('.text-content') as HTMLElement;
      const aiCaret = this.aiMsg.querySelector('.caret') as HTMLElement;
      const aiThinking = this.aiMsg.querySelector('[data-thinking]') as HTMLElement;

      userContent.textContent = this.userText;
      userCaret.classList.remove('is-active');
      aiContent.textContent = this.aiText;
      aiCaret.classList.remove('is-active');
      aiThinking.classList.add('is-hidden');
    }

    replay() {
      this.cancelled = true;
      window.setTimeout(() => {
        this.cancelled = false;
        this.running = false;
        if (this.reducedMotion) {
          this.renderStatic();
        } else {
          void this.play();
        }
      }, 60);
    }

    sleep(ms: number): Promise<void> {
      return new Promise((resolve) => {
        window.setTimeout(resolve, ms);
      });
    }
  }

  const initialized = new WeakSet<HTMLElement>();

  function init() {
    document.querySelectorAll<HTMLElement>('.chat-demo').forEach((el) => {
      if (initialized.has(el)) return;
      initialized.add(el);
      new ChatDemoPlayer(el);
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .chat-demo {
    margin: 1.75rem 0;
    padding: 1rem 1rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.85rem;
    background: var(--sl-color-bg-nav, var(--sl-color-bg));
    font-family: var(--sl-font);
  }

  .chat-stage {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .message {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .message-user {
    flex-direction: row-reverse;
  }

  .avatar {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--sl-color-gray-6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    user-select: none;
  }

  .message-user .avatar {
    background: var(--sl-color-accent-low);
  }

  .bubble {
    max-width: min(78%, 520px);
    padding: 0.55rem 0.85rem;
    border-radius: 0.9rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .message-user .bubble {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert, #fff);
    border-bottom-right-radius: 0.25rem;
  }

  .message-ai .bubble {
    border-bottom-left-radius: 0.25rem;
  }

  .label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.7;
    margin-bottom: 0.2rem;
  }

  /* ----- Stacking ghost + visible nello stesso grid cell -----
     Il ghost ha il testo completo (resta a riservare lo spazio) ma è
     visivamente trasparente. Il layer visibile ci scrive sopra. Risultato:
     la bolla ha sempre la dimensione finale, indipendentemente dalla
     porzione di testo che è stata "digitata". */
  .text {
    display: grid;
    grid-template-areas: 'stack';
    line-height: 1.5;
    word-break: break-word;
  }

  .text > * {
    grid-area: stack;
    min-width: 0;
  }

  .text-ghost {
    color: transparent;
    user-select: none;
    pointer-events: none;
    white-space: pre-wrap;
    /* `visibility: visible` esplicito così resta accessibile a screen reader.
       (color: transparent non lo rimuove dall'accessibility tree.) */
    visibility: visible;
  }

  .text-visible {
    white-space: pre-wrap;
  }

  .text-content {
    /* Vuoto fino a quando JS non scrive il typewriter. Senza JS resta
       valorizzato dal SSR (= stato finale visibile). */
  }

  /* ----- Caret blinking (visibile solo durante la digitazione) ----- */
  .caret {
    display: none;
    width: 0.55ch;
    height: 1em;
    margin-left: 1px;
    background: currentColor;
    vertical-align: text-bottom;
    opacity: 0.85;
  }

  .chat-demo.is-enhanced .caret.is-active {
    display: inline-block;
    animation: chat-demo-blink 900ms steps(2, start) infinite;
  }

  @keyframes chat-demo-blink {
    0%, 49% { opacity: 0.85; }
    50%, 100% { opacity: 0; }
  }

  /* ----- Thinking dots (visibili solo in modalità animata) ----- */
  .thinking {
    display: none;
    gap: 0.3rem;
    padding: 0.05rem 0;
    /* Inline-flex per non rompere il flow del text-content che segue. */
    vertical-align: middle;
  }

  .chat-demo.is-enhanced .thinking {
    display: inline-flex;
  }

  .chat-demo.is-enhanced .thinking.is-hidden {
    display: none;
  }

  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sl-color-gray-3);
    animation: chat-demo-dot 1200ms infinite ease-in-out;
  }

  .message-user .dot {
    background: var(--sl-color-text-invert, #fff);
    opacity: 0.8;
  }

  .dot:nth-child(2) { animation-delay: 150ms; }
  .dot:nth-child(3) { animation-delay: 300ms; }

  @keyframes chat-demo-dot {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.45; }
    30%           { transform: translateY(-0.28rem); opacity: 1; }
  }

  /* ----- Stato statico (no JS, no animazione) -----
     Senza .is-enhanced, il layer visibile mostra il SSR (testo completo),
     dots e caret restano nascosti. La bolla è alla dimensione finale. */
  .chat-demo:not(.is-enhanced) .caret {
    display: none;
  }

  .chat-demo:not(.is-enhanced) .thinking {
    display: none;
  }

  /* ----- Controlli ----- */
  .chat-controls {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.65rem;
  }

  .btn-replay {
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
    transition: background 120ms ease;
  }

  .btn-replay:hover {
    background: var(--sl-color-gray-6);
  }

  .btn-replay:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret,
    .dot {
      animation: none;
    }
  }
</style>
