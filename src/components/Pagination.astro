---
/**
 * Override del componente Pagination di Starlight.
 *
 * Mostra solo la "Prossima lezione" come foglio con l'angolo piegato
 * ("girare pagina"), senza "Precedente", in linea con la direzione
 * "manuale guidato": il lettore non-tecnico segue un percorso lineare
 * in avanti, raramente torna indietro tramite paginazione (ha la
 * sidebar per quello).
 *
 * Etichette localizzate per IT/EN. Il path della prossima pagina viene
 * preso da Starlight (`Astro.locals.starlightRoute.pagination`).
 */

const route = Astro.locals.starlightRoute;
const next = route?.pagination?.next;

const locale = Astro.currentLocale ?? 'it';
const LABELS: Record<string, { meta: string; arrowAria: string }> = {
  it: { meta: 'Prossima lezione', arrowAria: 'Vai alla lezione successiva' },
  en: { meta: 'Next lesson', arrowAria: 'Go to next lesson' },
};
const labels = LABELS[locale] ?? LABELS.it;
---

{next && (
  <a class="next-lesson not-content" href={next.href} aria-label={labels.arrowAria}>
    <div class="next-lesson-text">
      <span class="next-lesson-meta">{labels.meta}</span>
      <span class="next-lesson-title">{next.label}</span>
    </div>
    <svg class="next-lesson-arrow" viewBox="0 0 40 24" width="40" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 12.5C12 11.4 23 12.6 36 12" />
      <path d="M28.5 4.8C31.8 8 34.6 10.3 36.6 12C34 14 31 16.4 28.2 19.4" />
    </svg>
  </a>
)}

<style>
  /* A sheet with its bottom-right corner folded: the page you turn.
     The fold is the top-left half of a square, the other half is the
     page behind. */
  .next-lesson {
    --fold: 1.8rem;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 3rem 0 0;
    padding: 1.3rem calc(var(--fold) + 1rem) 1.3rem 1.5rem;
    background: var(--aig-elevated-bg);
    border: var(--aig-border-width) solid var(--sl-color-hairline-shade);
    border-radius: var(--aig-radius) var(--aig-radius) 0 var(--aig-radius);
    text-decoration: none;
    color: var(--sl-color-text);
  }

  .next-lesson::after {
    content: '';
    position: absolute;
    right: calc(var(--aig-border-width) * -1);
    bottom: calc(var(--aig-border-width) * -1);
    width: var(--fold);
    height: var(--fold);
    background: linear-gradient(
      315deg,
      var(--sl-color-bg) 50%,
      var(--sl-color-hairline-shade) 50%
    );
    pointer-events: none;
  }

  .next-lesson:hover {
    --fold: 2.4rem;
    border-color: var(--aig-ink);
    background: var(--aig-hover-wash);
  }

  .next-lesson:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  .next-lesson-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .next-lesson-meta {
    font-family: var(--aig-font-hand);
    font-size: 1rem;
    font-weight: 500;
    color: var(--sl-color-gray-3);
  }

  .next-lesson-title {
    font-size: 1.2rem;
    font-weight: 780;
    letter-spacing: -0.01em;
    color: var(--aig-heading);
  }

  .next-lesson-arrow {
    color: var(--aig-ink);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .next-lesson {
      padding: 1.1rem calc(var(--fold) + 0.6rem) 1.1rem 1.2rem;
    }
    .next-lesson-title {
      font-size: 1.05rem;
    }
    .next-lesson-arrow {
      width: 30px;
    }
  }
</style>
