---
/**
 * Search override.
 *
 * Replica la struttura del Search di Starlight (stesso markup, stesso
 * custom element `<site-search>`) ma cambia il momento in cui viene
 * montata la PagefindUI. Il default di Starlight aspetta
 * `DOMContentLoaded`, che con le view transitions di Astro
 * (`<ClientRouter />` in `Head.astro`) spara solo al primo caricamento:
 * dopo la prima navigazione, il DOM viene sostituito, un nuovo
 * `<site-search>` viene creato, il suo constructor registra un
 * listener su un evento che non riaccade, e il modale rimane vuoto
 * (nessun campo di input, nessun risultato).
 *
 * Fix: `initPagefindUI()` viene chiamata subito se il DOM è già
 * pronto, altrimenti all'evento `DOMContentLoaded`. Una flag
 * `__starlightSearchReady` sul singleton dell'istanza PagefindUI evita
 * doppi montaggi se il constructor di `<site-search>` girasse più volte
 * sulla stessa istanza dell'elemento.
 *
 * Tutto il resto (aria, shortcut keyboard, stili) è invariato rispetto
 * al default Starlight, così si hanno zero regressioni sulla UX della
 * ricerca.
 */
import { Icon } from '@astrojs/starlight/components';
import project from 'virtual:starlight/project-context';

const pagefindTranslations = {
  placeholder: Astro.locals.t('search.label'),
  ...Object.fromEntries(
    Object.entries(Astro.locals.t.all())
      .filter(([key]) => key.startsWith('pagefind.'))
      .map(([key, value]) => [key.replace('pagefind.', ''), value]),
  ),
};

const dataAttributes: DOMStringMap = {
  'data-translations': JSON.stringify(pagefindTranslations),
};
if (project.trailingSlash === 'never') {
  dataAttributes['data-strip-trailing-slash'] = '';
}
---

<site-search class={Astro.props.class} {...dataAttributes}>
  <button
    data-open-modal
    disabled
    aria-label={Astro.locals.t('search.label')}
    aria-keyshortcuts="Control+K"
  >
    <Icon name="magnifier" />
    <span class="sl-hidden md:sl-block" aria-hidden="true">
      {Astro.locals.t('search.label')}
    </span>
    <kbd class="sl-hidden md:sl-flex" style="display: none;">
      <kbd>{Astro.locals.t('search.ctrlKey')}</kbd><kbd>K</kbd>
    </kbd>
  </button>

  <dialog style="padding:0" aria-label={Astro.locals.t('search.label')}>
    <div class="dialog-frame sl-flex">
      <button data-close-modal class="sl-flex md:sl-hidden">
        {Astro.locals.t('search.cancelLabel')}
      </button>
      {
        import.meta.env.DEV ? (
          <div
            style="margin: auto; text-align: center; white-space: pre-line;"
            dir="ltr"
          >
            <p>{Astro.locals.t('search.devWarning')}</p>
          </div>
        ) : (
          <div class="search-container">
            <div id="starlight__search" />
          </div>
        )
      }
    </div>
  </dialog>
</site-search>

<script is:inline>
  (() => {
    const openBtn = document.querySelector('button[data-open-modal]');
    const shortcut = openBtn?.querySelector('kbd');
    if (!openBtn || !(shortcut instanceof HTMLElement)) return;
    const platformKey = shortcut.querySelector('kbd');
    if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      platformKey.textContent = '⌘';
      openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
    }
    shortcut.style.display = '';
  })();
</script>

<script>
  import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

  class SiteSearch extends HTMLElement {
    constructor() {
      super();
      const openBtn =
        this.querySelector<HTMLButtonElement>('button[data-open-modal]')!;
      const closeBtn =
        this.querySelector<HTMLButtonElement>('button[data-close-modal]')!;
      const dialog = this.querySelector('dialog')!;
      const dialogFrame = this.querySelector('.dialog-frame')!;

      const onClick = (event: MouseEvent) => {
        const isLink = 'href' in (event.target || {});
        if (
          isLink ||
          (document.body.contains(event.target as Node) &&
            !dialogFrame.contains(event.target as Node))
        ) {
          closeModal();
        }
      };

      const openModal = (event?: MouseEvent) => {
        dialog.showModal();
        document.body.toggleAttribute('data-search-modal-open', true);
        this.querySelector('input')?.focus();
        event?.stopPropagation();
        window.addEventListener('click', onClick);
      };

      const closeModal = () => dialog.close();

      openBtn.addEventListener('click', openModal);
      openBtn.disabled = false;
      closeBtn.addEventListener('click', closeModal);

      dialog.addEventListener('close', () => {
        document.body.toggleAttribute('data-search-modal-open', false);
        window.removeEventListener('click', onClick);
      });

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey === true || e.ctrlKey === true) && e.key === 'k') {
          dialog.open ? closeModal() : openModal();
          e.preventDefault();
        }
      });

      let translations = {};
      try {
        translations = JSON.parse(this.dataset.translations || '{}');
      } catch {
        /* ignore */
      }

      const shouldStrip = this.dataset.stripTrailingSlash !== undefined;
      const stripTrailingSlash = (path: string) =>
        path.replace(/(.)\/(#.*)?$/, '$1$2');
      const formatURL = shouldStrip
        ? stripTrailingSlash
        : (path: string) => path;

      const initPagefindUI = async () => {
        if (import.meta.env.DEV) return;
        // Su ogni page-load (anche post view transition) viene creato
        // un nuovo `#starlight__search` vuoto. Montiamo la PagefindUI
        // se e solo se il container di QUESTA istanza è ancora vuoto,
        // usando una flag sul container (non globale): così la
        // ricostruiamo dopo ogni navigazione, senza doppio-mount
        // sulla stessa istanza.
        const container = document.getElementById('starlight__search');
        if (!container) return;
        if (container.dataset.pfMounted === 'true') return;
        container.dataset.pfMounted = 'true';
        const onIdle =
          window.requestIdleCallback || ((cb: IdleRequestCallback) => setTimeout(cb as never, 1));
        onIdle(async () => {
          // @ts-expect-error — no types published by @pagefind/default-ui
          const { PagefindUI } = await import('@pagefind/default-ui');
          new PagefindUI({
            ...pagefindUserConfig,
            element: '#starlight__search',
            baseUrl: import.meta.env.BASE_URL,
            bundlePath:
              import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
            showImages: false,
            translations,
            showSubResults: true,
            processResult: (result: {
              url: string;
              sub_results: Array<{ url: string }>;
            }) => {
              result.url = formatURL(result.url);
              result.sub_results = result.sub_results.map((sub_result) => {
                sub_result.url = formatURL(sub_result.url);
                return sub_result;
              });
            },
          });
        });
      };

      // Initial load: DOMContentLoaded si non è ancora sparato, aspetto.
      // Post-navigation (astro:page-load): il doc è già 'interactive' o
      // 'complete', inizializzo subito.
      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', initPagefindUI);
      } else {
        initPagefindUI();
      }
    }
  }

  if (!customElements.get('site-search')) {
    customElements.define('site-search', SiteSearch);
  }
</script>

<style>
  @layer starlight.core {
    site-search {
      display: contents;
    }
    button[data-open-modal] {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border: 0;
      background-color: transparent;
      color: var(--sl-color-gray-1);
      cursor: pointer;
      height: 2.5rem;
      font-size: var(--sl-text-xl);
    }
    button[data-open-modal]:disabled {
      cursor: wait;
      opacity: 0.5;
    }
    button[data-open-modal] kbd {
      background-color: var(--sl-color-gray-5);
      color: var(--sl-color-gray-2);
      padding: 0.125rem 0.25rem;
      border-radius: 0.25rem;
      gap: 0.125rem;
      align-items: center;
      font-size: var(--sl-text-xs);
      font-family: var(--sl-font);
    }
    button[data-open-modal] kbd kbd {
      border: 0;
      padding: 0;
      line-height: 1;
    }

    dialog {
      margin: 0;
      background-color: var(--sl-color-gray-6);
      border: 1px solid var(--sl-color-gray-5);
      width: 100%;
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      box-shadow: var(--sl-shadow-lg);
    }
    dialog[open] {
      display: flex;
    }
    dialog::backdrop {
      background-color: var(--sl-color-backdrop-overlay);
      -webkit-backdrop-filter: blur(0.25rem);
      backdrop-filter: blur(0.25rem);
    }
    body[data-search-modal-open] {
      overflow: hidden;
    }

    .dialog-frame {
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
    }

    button[data-close-modal] {
      position: absolute;
      z-index: 1;
      align-items: center;
      align-self: flex-end;
      height: calc(64px * var(--pagefind-ui-scale));
      padding: 0.25rem;
      border: 0;
      background: transparent;
      cursor: pointer;
      color: var(--sl-color-text-accent);
    }

    #starlight__search {
      --pagefind-ui-primary: var(--sl-color-accent-high);
      --pagefind-ui-text: var(--sl-color-gray-1);
      --pagefind-ui-background: var(--sl-color-bg);
      --pagefind-ui-border: var(--sl-color-gray-5);
      --pagefind-ui-border-radius: 0.5rem;
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-font: var(--sl-font);
    }

    @media (min-width: 50rem) {
      site-search {
        width: 100%;
        max-width: 22rem;
      }

      button[data-open-modal] {
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.5rem;
        padding-inline-start: 0.75rem;
        padding-inline-end: 1rem;
        background-color: var(--sl-color-black);
        justify-content: space-between;
        width: 100%;
      }
      button[data-open-modal] kbd {
        background-color: var(--sl-color-gray-6);
      }

      dialog {
        margin: 4rem auto auto;
        border-radius: 0.5rem;
        width: 90%;
        max-width: 40rem;
        height: max-content;
        min-height: 15rem;
        max-height: calc(100% - 8rem);
      }

      .dialog-frame {
        padding: 1rem;
      }
    }

    @media (prefers-reduced-motion) {
      dialog::backdrop {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
    }
  }
</style>
