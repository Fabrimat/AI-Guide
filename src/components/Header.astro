---
/**
 * Override del Header di Starlight.
 *
 * Motivo: il default di Starlight mette in riga ThemeSelect,
 * LanguageSelect e SocialIcons sulla destra. Appesantiva l'header
 * e non lasciava spazio per etichette leggibili. Qui sostituiamo la
 * terna con un singolo bottone "Preferenze" (icona sliders) che apre
 * un popover con le tre impostazioni nominate ed etichettate.
 *
 * Il bottone resta visibile anche su mobile (no `md:sl-flex`), così
 * sulle pagine splash senza sidebar c'è sempre un modo per cambiare
 * lingua e tema. In parallelo, `MobileMenuFooter` è overridden a vuoto
 * per evitare che theme/lang compaiano due volte nel menu mobile.
 */
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import config from 'virtual:starlight/user-config';

import HeaderPreferences from './HeaderPreferences.astro';

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-flex print:hidden header-prefs-wrap">
    <HeaderPreferences />
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .header-prefs-wrap {
    align-items: center;
  }

  /* Notebook top edge: the header is the cover strip of the quaderno,
     closed by a ruled line a touch stronger than the page hairlines. */
  :global(header.header) {
    border-bottom: var(--aig-border-width) solid var(--sl-color-hairline-shade);
  }

  /* Wordmark: the favicon mark (paper tile, "AI" in biro) followed by
     "AI-Guide" in Atkinson heavy, in biro ink (chalk blue in dark).
     The mark is a CSS background so Starlight's SiteTitle markup stays
     untouched. */
  .title-wrapper :global(.site-title) {
    gap: 0.55rem;
    font-family: var(--sl-font);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--aig-ink);
    text-decoration: none;
    border-radius: var(--aig-radius);
  }
  .title-wrapper :global(.site-title)::before {
    content: '';
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    background: url('/favicon.svg') center / contain no-repeat;
    border-radius: 6px;
  }
  .title-wrapper :global(.site-title:hover) {
    background-image: var(--aig-highlight-stroke);
    background-repeat: no-repeat;
    background-position: 0 70%;
    background-size: 100% 45%;
  }
  .title-wrapper :global(.site-title img) {
    display: none;
  }
</style>
