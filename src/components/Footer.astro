---
/**
 * Footer override.
 *
 * Wrappa il footer di default di Starlight (che a sua volta renderizza
 * la nostra Pagination override + eventuali EditLink/LastUpdated futuri)
 * e aggiunge sotto la riga del progetto: link "About" + tre icone social
 * (LinkedIn, mail, sito personale).
 *
 * Le icone sono SVG inline per non introdurre dipendenze. I path social
 * sono hardcoded perché appartengono all'autore del manuale, non sono
 * configurabili da terzi.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import { t, getLocale } from '../i18n/ui';

const ui = t(Astro.currentLocale);
const locale = getLocale(Astro.currentLocale);
const aboutHref = `/${locale}/about/`;

const LINKEDIN_URL = 'https://linkedin.com/in/fabriziolarosa';
const SITE_URL = 'https://larosa.work';
const MAIL = 'aiguide@larosa.work';
---

<Default />

<div class="ai-guide-footer not-content">
  <div class="agf-row">
    <a class="agf-about" href={aboutHref}>{ui.footerAbout}</a>
    <span class="agf-tagline">{ui.footerTagline}</span>
  </div>

  <ul class="agf-socials" aria-label={ui.footerAbout}>
    <li>
      <a
        href={LINKEDIN_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ui.footerLinkedinAria}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.36 4.26 5.43v6.31zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"/>
        </svg>
      </a>
    </li>
    <li>
      <a
        href={`mailto:${MAIL}`}
        aria-label={ui.footerEmailAria}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="M3 7l9 6 9-6"/>
        </svg>
      </a>
    </li>
    <li>
      <a
        href={SITE_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ui.footerSiteAria}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"/>
          <path d="M3 12h18"/>
          <path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
        </svg>
      </a>
    </li>
  </ul>
</div>

<style>
  .ai-guide-footer {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .agf-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    font-size: 0.9rem;
  }

  .agf-about {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .agf-about:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  .agf-tagline {
    color: var(--sl-color-gray-3);
    font-size: 0.88rem;
  }

  .agf-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
  }

  .agf-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-hairline);
    background: transparent;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .agf-socials a:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent-low);
    color: var(--sl-color-text);
  }

  .agf-socials svg {
    display: block;
  }
</style>
