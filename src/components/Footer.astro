---
/**
 * Footer override.
 *
 * Wrappa il footer di default di Starlight (che a sua volta renderizza
 * la nostra Pagination override + eventuali EditLink/LastUpdated futuri)
 * e aggiunge sotto la riga del progetto: link "About" + tre icone social
 * (LinkedIn, mail, sito personale).
 *
 * Le icone sono SVG inline per non introdurre dipendenze. I path social
 * sono hardcoded perché appartengono all'autore del manuale, non sono
 * configurabili da terzi.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import ShareLesson from './ShareLesson.astro';
import ChatPanel from './LocalAI/ChatPanel.astro';
import { t, getLocale } from '../i18n/ui';
import { getLlmsTxtData } from '../../scripts/llms-txt-data.mjs';

// Crawler-only site index: same data as `/llms.txt`, embedded on every
// page inside a `<nav hidden>` so LLM crawlers (GPTBot, ClaudeBot,
// PerplexityBot, etc.) that don't fetch /llms.txt separately still
// discover the full structure of the manual from any landing page.
// The `hidden` attribute hides it from sighted users and screen readers
// both; the DOM is preserved, which is what crawlers parse.
//
// We deliberately render section labels as `<p><strong>` rather than
// `<h2>` to avoid duplicating heading levels across every page (which
// would dilute the actual lesson H1/H2 signals for SEO). Crawlers care
// about the `<a href>` links here, not the heading levels.
const llmsIndex = await getLlmsTxtData();

const ui = t(Astro.currentLocale);
const locale = getLocale(Astro.currentLocale);
const aboutHref = `/${locale}/about/`;
const privacyHref = `/${locale}/privacy/`;
const currentYear = new Date().getFullYear();

// Build identity (vedi `astro.config.mjs > vite.define`). Mostrata nel
// footer come riga discreta, utile a chi ha installato la PWA per
// capire quale build sta vedendo dopo un aggiornamento del SW.
const buildSha = __AIGUIDE_BUILD_SHA__;
const buildTime = __AIGUIDE_BUILD_TIME__;

// Share buttons solo sulle pagine "lezione", riconosciute dalla
// presenza di `livello` nel frontmatter (stessa chiave usata dallo
// schema content). Sono esclusi homepage, about, privacy, glossario,
// 404. Il titolo e l'URL canonico li leggiamo dal route Starlight,
// così il tab di condivisione punta sempre all'URL locale effettivo
// (niente hardcoding di dominio o path).
const route = Astro.locals.starlightRoute;
const isLesson = Boolean(route?.entry?.data?.livello);
const shareUrl = isLesson ? new URL(Astro.url.pathname, Astro.site).toString() : '';
const shareTitle = isLesson ? route?.entry?.data?.title ?? '' : '';

const LINKEDIN_URL = 'https://linkedin.com/in/fabriziolarosa';
const SITE_URL = 'https://larosa.work';
const KOFI_URL = 'https://ko-fi.com/fabriziolarosa';
const GITHUB_URL = 'https://github.com/Fabrimat/AI-Guide';
// P.IVA esposta perché il sito rafforza la brand awareness di
// larosa.work (attività economica). Direttiva UE e-Commerce e Code
// de Droit Économique belga richiedono trasparenza sull'operatore
// quando un sito fa parte di un'attività commerciale, anche se il
// contenuto in sé è gratuito.
const VAT = 'BE1031214819';
// Mail split in user/domain per obfuscation: il DOM statico non
// contiene mai la stringa `user@domain` unita, i crawler spam che
// scansionano HTML grezzo non trovano una mail leggibile. Lo script
// in fondo a questo file ricompone href e testo al caricamento.
const MAIL_USER = 'ai-guide';
const MAIL_DOMAIN = 'larosa.work';
---

{isLesson && <ShareLesson url={shareUrl} title={shareTitle} />}

<Default />

<div class="ai-guide-footer not-content">
  <div class="agf-row">
    <a class="agf-about" href={aboutHref} target="_blank" rel="noopener noreferrer">{ui.footerAbout}</a>
    <span class="agf-sep" aria-hidden="true">·</span>
    <a class="agf-about" href={privacyHref} target="_blank" rel="noopener noreferrer">{ui.footerPrivacy}</a>
    <span class="agf-sep" aria-hidden="true">·</span>
    <span class="agf-tagline">{ui.footerTagline}</span>
  </div>

  <small class="agf-copyright">
    {ui.footerCopyright(currentYear)}
    <span class="agf-sep" aria-hidden="true">·</span>
    {ui.footerLocation}
    <span class="agf-sep" aria-hidden="true">·</span>
    {ui.footerVatLabel} {VAT}
  </small>

  <small class="agf-build" title={`commit ${buildSha} · build ${buildTime}`}>
    v {buildSha} <span class="agf-sep" aria-hidden="true">·</span> {buildTime}
  </small>

  <ul class="agf-socials" aria-label={ui.footerAbout}>
    <li>
      <a
        href={LINKEDIN_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ui.footerLinkedinAria}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.36 4.26 5.43v6.31zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"/>
        </svg>
      </a>
    </li>
    <li>
      <a
        href="#"
        data-obf-email
        data-user={MAIL_USER}
        data-domain={MAIL_DOMAIN}
        rel="nofollow"
        aria-label={ui.footerEmailAria}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="M3 7l9 6 9-6"/>
        </svg>
      </a>
    </li>
    <li>
      <a
        href={SITE_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ui.footerSiteAria}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"/>
          <path d="M3 12h18"/>
          <path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
        </svg>
      </a>
    </li>
    <li>
      <a
        href={KOFI_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ui.footerKofiAria}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 8h1a4 4 0 0 1 0 8h-1"/>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8z"/>
          <line x1="6" y1="2" x2="6" y2="4"/>
          <line x1="10" y1="2" x2="10" y2="4"/>
          <line x1="14" y1="2" x2="14" y2="4"/>
        </svg>
      </a>
    </li>
    <li>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ui.footerGithubAria}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.575.106.785-.25.785-.556 0-.274-.01-1-.015-1.964-3.196.695-3.87-1.54-3.87-1.54-.523-1.33-1.277-1.684-1.277-1.684-1.044-.714.079-.699.079-.699 1.155.081 1.763 1.186 1.763 1.186 1.026 1.758 2.693 1.25 3.35.956.104-.744.401-1.25.73-1.538-2.552-.29-5.236-1.276-5.236-5.68 0-1.255.448-2.28 1.183-3.084-.119-.29-.513-1.459.112-3.042 0 0 .965-.309 3.163 1.178a10.98 10.98 0 0 1 2.88-.388c.977.005 1.96.132 2.88.388 2.196-1.487 3.16-1.178 3.16-1.178.626 1.583.232 2.752.114 3.042.736.804 1.18 1.829 1.18 3.084 0 4.415-2.688 5.386-5.248 5.67.413.356.78 1.057.78 2.13 0 1.54-.014 2.78-.014 3.158 0 .308.208.668.79.555A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/>
        </svg>
      </a>
    </li>
  </ul>
</div>

<script>
  // Wire-a ogni elemento `[data-obf-email]` presente in pagina:
  // ricompone user@domain dai data attributes, aggiorna href e il
  // testo del fallback (se presente). Il Footer è incluso in ogni
  // pagina del sito, quindi basta un solo script qui per coprire
  // tutti gli ObfuscatedEmail sparsi nei contenuti.
  function wireObfuscatedEmails() {
    document
      .querySelectorAll<HTMLAnchorElement>('a[data-obf-email]')
      .forEach((a) => {
        if (a.dataset.oeWired === 'true') return;
        a.dataset.oeWired = 'true';
        const user = a.dataset.user ?? '';
        const domain = a.dataset.domain ?? '';
        if (!user || !domain) return;
        const email = `${user}@${domain}`;
        a.href = `mailto:${email}`;
        const fallback = a.querySelector<HTMLElement>('[data-oe-fallback]');
        if (fallback) fallback.textContent = email;
      });
  }

  wireObfuscatedEmails();
  document.addEventListener('astro:page-load', wireObfuscatedEmails);
</script>

<style>
  .ai-guide-footer {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .agf-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    font-size: 0.9rem;
  }

  .agf-about {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .agf-about:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  .agf-tagline {
    color: var(--sl-color-gray-3);
    font-size: 0.88rem;
  }

  .agf-copyright {
    color: var(--sl-color-gray-3);
    font-size: 0.82rem;
  }

  .agf-build {
    color: var(--sl-color-gray-4);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .agf-sep {
    margin: 0 0.45em;
    color: var(--sl-color-gray-4);
  }

  .agf-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
  }

  .agf-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-hairline);
    background: transparent;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .agf-socials a:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent-low);
    color: var(--sl-color-text);
  }

  .agf-socials svg {
    display: block;
  }
</style>

<nav class="aig-crawler-index not-content" hidden aria-label="Site index for crawlers">
  <p><strong>{llmsIndex.title}</strong></p>
  <p>{llmsIndex.summary}</p>
  <p>{llmsIndex.intro}</p>

  {llmsIndex.sections.map((section) => (
    section.items.length > 0 && (
      <>
        <p><strong>{section.label}</strong></p>
        <ul>
          {section.items.map((item) => (
            <li>
              <a href={item.url}>{item.title}</a>{item.description ? `: ${item.description}` : ''}
            </li>
          ))}
        </ul>
      </>
    )
  ))}

  {llmsIndex.reference.length > 0 && (
    <>
      <p><strong>Reference</strong></p>
      <ul>
        {llmsIndex.reference.map((item) => (
          <li>
            <a href={item.url}>{item.title}</a>{item.description ? `: ${item.description}` : ''}
          </li>
        ))}
      </ul>
    </>
  )}

  <p><strong>Translations</strong></p>
  <p>{llmsIndex.translations}</p>

  {llmsIndex.optional.length > 0 && (
    <>
      <p><strong>Optional</strong></p>
      <ul>
        {llmsIndex.optional.map((item) => (
          <li>
            <a href={item.url}>{item.title}</a>{item.description ? `: ${item.description}` : ''}
          </li>
        ))}
      </ul>
    </>
  )}
</nav>

<ChatPanel />
