---
/**
 * Riepilogo della lezione in 30 secondi. Posizionato in alto alla
 * lezione, subito dopo l'H1: chi skimma lo apre, chi legge tutto lo
 * ignora. Collassato di default via `<details>` nativo.
 *
 * Uso (in un .mdx):
 *   <LessonSummary>
 *
 *   - Punto uno
 *   - Punto due
 *   - Punto tre
 *
 *   </LessonSummary>
 *
 * Nota: le linee vuote sopra e sotto la lista sono necessarie perché
 * MDX parsi il markdown dentro il componente.
 */
interface Props {
  label?: string;
}

import Glyph from './Glyph.astro';
import { t } from '../i18n/ui';
const ui = t(Astro.currentLocale);
const { label = ui.lessonSummaryLabel } = Astro.props;
---

<details class="lesson-summary not-content">
  <summary>
    <span class="icon" aria-hidden="true"><Glyph name="list" /></span>
    <span class="label">{label}</span>
    <span class="chevron" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="4 6 8 10 12 6"></polyline>
      </svg>
    </span>
  </summary>
  <div class="body">
    <slot />
  </div>
</details>

<style>
  /* A notebook tab: a slip with a biro outline that opens into the body. */
  .lesson-summary {
    display: block;
    box-sizing: border-box;
    width: 100%;
    margin: 1rem 0 1.75rem;
    margin-inline: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .lesson-summary summary {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--aig-ink);
    background: var(--aig-elevated-bg);
    border: var(--aig-border-width) solid var(--aig-ink);
    border-radius: var(--aig-radius);
    list-style: none;
    user-select: none;
  }
  .lesson-summary summary::-webkit-details-marker {
    display: none;
  }
  .lesson-summary summary::marker {
    content: '';
  }
  .lesson-summary summary:hover {
    background: var(--aig-hover-wash);
  }
  .lesson-summary summary:focus-visible {
    outline: 2px solid var(--aig-ink);
    outline-offset: 2px;
  }
  .lesson-summary[open] summary {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-color: transparent;
    position: relative;
    z-index: 1;
    margin-bottom: calc(var(--aig-border-width) * -1);
  }
  .icon {
    font-size: 1rem;
    line-height: 1;
  }
  .label {
    flex: 1;
  }
  .chevron {
    display: inline-flex;
    align-items: center;
    color: var(--aig-ink);
    transition: transform 0.2s ease;
  }
  .lesson-summary[open] .chevron {
    transform: rotate(180deg);
  }
  .body {
    box-sizing: border-box;
    padding: 0.75rem 1rem 0.6rem;
    background: var(--aig-elevated-bg);
    border: var(--aig-border-width) solid var(--aig-ink);
    border-radius: 0 var(--aig-radius) var(--aig-radius) var(--aig-radius);
    font-size: 0.95rem;
  }
  .body :global(ul),
  .body :global(ol) {
    margin: 0.4rem 0;
    padding-left: 1.1rem;
  }
  .body :global(li) {
    margin: 0.3rem 0;
  }
  .body :global(li)::marker {
    color: var(--aig-ink);
  }
  .body :global(p) {
    margin: 0.4rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }
</style>
