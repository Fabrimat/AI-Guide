---
/**
 * Icon: curated set of inline SVG icons used by the navigation cards
 * (HomeCards). Style: single-weight biro line drawings, like doodles in
 * the margin of a notebook. One stroke colour (`--aig-ink`: biro in
 * light, chalk blue in dark), no fill, no background tile.
 *
 * All 24x24 viewBox, 1.6 stroke, round caps. The paths are drawn by hand
 * with slightly imperfect curves on purpose.
 *
 * To add an icon: add it to `IconName` and to the render below. Keep
 * `viewBox="0 0 24 24"` and omit stroke/fill on the root <svg> (they come
 * from the CSS).
 */

export type IconName = 'sprout' | 'pencil' | 'briefcase' | 'graduation-cap' | 'users' | 'wrench' | 'message-circle' | 'monitor';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<span class:list={['aig-icon', className]} aria-hidden="true">
  {name === 'sprout' && (
    <svg viewBox="0 0 24 24" width="40" height="40" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 21C12.3 17.2 11.8 13.6 12 10" />
      <path d="M12 14.2C8 14.6 5 12.6 4.4 8.4C8.6 7.9 11.6 10 12 14.2Z" />
      <path d="M12 11C12.4 7 15 3.9 19.6 3.4C20.1 7.6 17.1 10.6 12 11Z" />
      <path d="M7.4 21.3C10 20.8 14 21.4 16.6 21" />
    </svg>
  )}
  {name === 'pencil' && (
    <svg viewBox="0 0 24 24" width="40" height="40" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 20.2L5 15.5L16.4 4.1C17.5 3 19.3 3 20.4 4.1C21.5 5.2 21.5 7 20.4 8.1L8.8 19.4Z" />
      <path d="M14.4 6.2L18.3 10" />
      <path d="M5 15.5L8.7 19.3" />
    </svg>
  )}
  {name === 'briefcase' && (
    <svg viewBox="0 0 24 24" width="40" height="40" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3.6 8C3.6 7.2 4.1 6.7 4.9 6.7L19.2 6.6C20 6.6 20.6 7.2 20.5 8L20.4 18C20.4 18.8 19.8 19.4 19 19.4L5 19.5C4.2 19.5 3.6 18.9 3.6 18Z" />
      <path d="M9 6.7L9.2 4.7C9.2 4.2 9.6 3.8 10.1 3.8L13.9 3.8C14.4 3.8 14.8 4.2 14.8 4.7L15 6.6" />
      <path d="M3.6 12.6C8 13.6 16 13.6 20.4 12.5" />
      <path d="M12 12.4V14.4" />
    </svg>
  )}
  {name === 'graduation-cap' && (
    <svg viewBox="0 0 24 24" width="40" height="40" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2.5 9L12 4.2L21.5 9L12 13.8Z" />
      <path d="M6.6 11.9V16.2C8.6 18.4 15.4 18.4 17.4 16.2V11.9" />
      <path d="M21.5 9V15.2" />
      <path d="M21.5 15.2L20.7 17.6" />
    </svg>
  )}
  {name === 'users' && (
    <svg viewBox="0 0 24 24" width="40" height="40" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 4.8C10.9 4.8 12.3 6.2 12.3 8C12.3 9.9 10.9 11.3 9 11.3C7.1 11.3 5.7 9.9 5.7 8C5.7 6.2 7.1 4.8 9 4.8Z" />
      <path d="M3 20.2C3.3 16.6 6 14.9 9 14.9C12 14.9 14.7 16.6 15 20.2" />
      <path d="M15.4 5.2C17.7 5.6 18.8 7.6 18 9.6C17.6 10.5 16.9 11 16.2 11.2" />
      <path d="M17.6 14.7C19.7 15.2 21 16.9 21.2 19.6" />
    </svg>
  )}
  {name === 'wrench' && (
    <svg viewBox="0 0 24 24" width="40" height="40" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14.7 6.3C14.3 7 14.4 7.5 14.8 7.9L16.2 9.3C16.6 9.7 17.2 9.7 17.6 9.3L21.2 5.8C22.1 8.4 21.4 11.2 19.3 12.8C17.5 14.2 15.2 14.4 13.2 13.5L6.5 20.2C5.6 21.1 4.2 21.1 3.4 20.3C2.6 19.5 2.6 18 3.5 17.2L10.4 10.5C9.5 8.5 9.8 6 11.4 4.2C13.1 2.5 15.6 2 17.7 3Z" />
    </svg>
  )}
  {name === 'message-circle' && (
    <svg viewBox="0 0 24 24" width="40" height="40" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 18.8L2.8 21.4L7 20C8.4 20.6 9.9 21 11.6 21C16.8 21 21 17 21 12C21 7 16.8 3 11.6 3C6.6 3 2.6 7 2.6 12C2.6 14.9 3.1 17 4 18.8Z" />
      <path d="M8.4 12H8.5M12 12H12.1M15.6 12H15.7" />
    </svg>
  )}
  {name === 'monitor' && (
    <svg viewBox="0 0 24 24" width="40" height="40" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3.4 4.6C8.9 4.3 15 4.2 20.6 4.5C20.9 7.7 20.9 11.4 20.6 14.6C15 14.9 9 14.9 3.4 14.6C3.1 11.3 3.1 7.8 3.4 4.6Z" />
      <path d="M6.6 8L8.6 9.6L6.7 11.2M10.4 11.3H13.2" />
      <path d="M12 15V18.6M7.8 19.6C10.6 19.2 13.4 19.2 16.2 19.6" />
    </svg>
  )}
</span>

<style>
  .aig-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    color: var(--aig-ink);
  }

  /* One weight, one colour: the ink. */
  .aig-icon svg {
    stroke: currentColor;
    stroke-width: 1.6;
    fill: none;
  }
</style>
