---
/**
 * Override del componente Head di Starlight.
 *
 * Fa cinque cose:
 *  1. Blocca il tema su "light" prima che il resto del JS si carichi
 *     (il sito ha una sola palette, "Pastello", quindi non ha senso
 *     persistere o offrire dark mode).
 *  2. Attiva le View Transitions di Astro (ClientRouter) per avere
 *     navigazione SPA-like fra pagine e fra lingue, senza flash bianco
 *     né reset dello stato della pagina.
 *  3. Carica il tracker di progresso (vedi `src/scripts/progress.ts`).
 *     Tutto in localStorage, nessun dato lascia il browser. Serve
 *     al componente `<Resume>` per il "riprendi da dove hai lasciato".
 *  4. Inietta `window.__AIGUIDE_TITLES__`, una mappa URL → titolo per
 *     ogni pagina del sito in ogni lingua. Usata da `<Resume>` e
 *     `<RecapWithAi>` per mostrare il titolo nel locale corrente anche
 *     se l'utente non ha mai visitato quella pagina in quella lingua.
 *  5. In produzione carica Simple Analytics, l'unico strumento di
 *     analytics aggregato del sito. No cookie, no fingerprint, IP
 *     scartato dopo aver derivato il paese. In dev è disattivato per
 *     non sporcare le statistiche con il lavoro di sviluppo. La SPA
 *     navigation di ClientRouter è gestita automaticamente dal loro
 *     script (osserva pushState/popstate). Lo script viene servito
 *     da `/sa/proxy.js` (first-party), passa attraverso il Worker
 *     `workers/sa-proxy/` su Cloudflare e arriva a Simple Analytics:
 *     così non viene bloccato dagli adblocker che filtrano per
 *     dominio `simpleanalyticscdn.com`. Vedi `privacy.mdx` per la
 *     versione user-facing.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';

const entries = await getCollection('docs');
const titleMap: Record<string, string> = {};
for (const entry of entries) {
  if (!entry.data.title) continue;
  // Routing di Starlight: /<id>/ per pagine normali, /<locale>/ per
  // <locale>/index. Normalizziamo entrambi i casi.
  let url = `/${entry.id}/`.replace(/\/+/g, '/');
  url = url.replace(/\/index\/$/, '/');
  titleMap[url] = entry.data.title;
}
---

<script is:inline>
  // Lock palette to light. Eseguito inline nel head così è la prima cosa
  // che gira: niente flash di un tema diverso prima del nostro CSS.
  document.documentElement.dataset.theme = 'light';
  try {
    localStorage.setItem('starlight-theme', 'light');
  } catch (_) {
    /* localStorage non disponibile (browser privato): ignora. */
  }
</script>

<script is:inline define:vars={{ titleMap }}>
  window.__AIGUIDE_TITLES__ = titleMap;
</script>

<Default><slot /></Default>

<meta property="og:image" content="https://ai-guide.larosa.work/og-image.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content="https://ai-guide.larosa.work/og-image.png" />

{import.meta.env.PROD && (
  <script async is:inline src="/sa/proxy.js"></script>
)}

<ClientRouter />

<script>
  import '../scripts/progress.ts';
</script>
