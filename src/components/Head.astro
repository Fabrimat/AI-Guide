---
/**
 * Override del componente Head di Starlight per attivare le View Transitions
 * di Astro (ClientRouter). Effetto: navigazione SPA-like fra pagine e lingue,
 * senza "flash bianco" né reset dello stato della pagina.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
---
<Default><slot /></Default>
<ClientRouter />
