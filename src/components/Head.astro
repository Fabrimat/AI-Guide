---
/**
 * Override del componente Head di Starlight.
 *
 * Fa quattro cose:
 *  1. Attiva le View Transitions di Astro (ClientRouter) per avere
 *     navigazione SPA-like fra pagine e fra lingue, senza flash bianco
 *     né reset dello stato della pagina.
 *  2. Carica il tracker di progresso (vedi `src/scripts/progress.ts`).
 *     Tutto in localStorage, nessun dato lascia il browser. Serve
 *     al componente `<Resume>` per il "riprendi da dove hai lasciato".
 *  3. Inietta `window.__AIGUIDE_TITLES__`, una mappa URL → titolo per
 *     ogni pagina del sito in ogni lingua. Usata da `<Resume>` e
 *     `<RecapWithAi>` per mostrare il titolo nel locale corrente anche
 *     se l'utente non ha mai visitato quella pagina in quella lingua.
 *  4. In produzione carica Simple Analytics, l'unico strumento di
 *     analytics aggregato del sito. No cookie, no fingerprint, IP
 *     scartato dopo aver derivato il paese. In dev è disattivato per
 *     non sporcare le statistiche con il lavoro di sviluppo. La SPA
 *     navigation di ClientRouter è gestita automaticamente dal loro
 *     script (osserva pushState/popstate). Lo script viene servito
 *     da `/sa/proxy.js` (first-party), passa attraverso il Worker
 *     `workers/sa-proxy/` su Cloudflare e arriva a Simple Analytics:
 *     così non viene bloccato dagli adblocker che filtrano per
 *     dominio `simpleanalyticscdn.com`. `data-collect-dnt="true"`
 *     forza la raccolta anche con Do Not Track attivo lato browser:
 *     SA non raccoglie dato personale, quindi non c'è profilazione
 *     da disattivare e perderemmo solo i lettori più privacy-aware.
 *     Vedi `privacy.mdx` per la versione user-facing.
 *
 * Nota sul tema: il sito supporta sia light (Pastello originale)
 * che warm dark (cioccolato + crema + coral). La scelta è persistita
 * da Starlight in `localStorage['starlight-theme']` e l'init senza
 * flash è gestito dal Head default (che include lo script inline di
 * Starlight). Non forziamo più il tema qui: il rispetto di
 * `prefers-color-scheme` e della preferenza utente è completamente
 * delegato a Starlight.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';

const entries = await getCollection('docs');
const titleMap: Record<string, string> = {};
for (const entry of entries) {
  if (!entry.data.title) continue;
  // Routing di Starlight: /<id>/ per pagine normali, /<locale>/ per
  // <locale>/index. Normalizziamo entrambi i casi.
  let url = `/${entry.id}/`.replace(/\/+/g, '/');
  url = url.replace(/\/index\/$/, '/');
  titleMap[url] = entry.data.title;
}

// --- SEO ---
// Starlight già emette: <title>, description, canonical, hreflang,
// og:title/type/url/locale/description/site_name, twitter:card. Qui
// aggiungiamo i tasselli che mancano per una SEO "forte":
//   - og:image:alt (accessibilità della preview)
//   - og:locale:alternate (segnala l'altra lingua agli scraper social)
//   - twitter:title + twitter:description espliciti (alcuni client
//     non leggono la fallback OG)
//   - meta author (Article + Open Graph article extension)
//   - JSON-LD WebSite sitewide
//   - JSON-LD Article + BreadcrumbList sulle pagine lezione
//
// Una "lezione" è una pagina con `livello` nel frontmatter (stessa
// chiave usata da PageTitle, Footer, ShareLesson). Le splash, About,
// Privacy, Glossary, 404 NON ricevono Article schema: non lo sono.

const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const data = entry?.data as
  | { title?: string; description?: string; livello?: string }
  | undefined;

const currentLocale: 'en' | 'it' = Astro.currentLocale === 'it' ? 'it' : 'en';
const alternateLocale: 'en' | 'it' = currentLocale === 'it' ? 'en' : 'it';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const pageTitle = data?.title ?? 'AI-Guide';
const pageDescription =
  data?.description ?? "Learn how to use AI, from the basics to advanced.";

const SITE_NAME = 'AI-Guide';
const SITE_URL = 'https://ai-guide.larosa.work/';
const OG_IMAGE = 'https://ai-guide.larosa.work/og-image.png';
const OG_IMAGE_ALT =
  'AI-Guide: a free manual to learn how to use AI, from the basics to advanced.';
const AUTHOR_NAME = 'Fabrizio La Rosa';
const AUTHOR_URL = 'https://larosa.work';

const isLesson = Boolean(data?.livello);
const livelloToSchema: Record<string, string> = {
  principiante: 'beginner',
  intermedio: 'intermediate',
  avanzato: 'advanced',
};
const educationalLevel = data?.livello ? livelloToSchema[data.livello] : undefined;

// Nome del modulo (Fundamentals / Everyday use / At work) per
// article:section + articleSection del JSON-LD. Derivato dal path:
// /en/fundamentals/foo/ → "Fundamentals". start-here/glossary/about
// sono pagine singole, non hanno una "section" sopra di loro.
const sectionLabels: Record<string, { en: string; it: string }> = {
  fundamentals: { en: 'Fundamentals', it: 'Fondamenti' },
  'everyday-use': { en: 'Everyday use', it: 'Uso quotidiano' },
  'at-work': { en: 'At work', it: 'Sul lavoro' },
};
const sectionMatch = Astro.url.pathname.match(/^\/(?:en|it)\/([^/]+)\//);
const sectionKey = sectionMatch?.[1];
const articleSection =
  isLesson && sectionKey && sectionLabels[sectionKey]
    ? sectionLabels[sectionKey][currentLocale]
    : null;

// Breadcrumb a due livelli: home della lingua corrente → pagina.
// I "moduli" intermedi (Fundamentals, Everyday use, At work) non
// hanno una landing page propria, quindi non li includiamo come
// nodi cliccabili: schema.org permette nodi senza `item`, ma Google
// preferisce breadcrumb con URL veri. Tenerlo a due livelli è la
// scelta più pulita e ben supportata.
const localeHomeUrl = `${SITE_URL}${currentLocale}/`;
const breadcrumbJsonLd = isLesson
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: SITE_NAME,
          item: localeHomeUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pageTitle,
          item: canonicalUrl,
        },
      ],
    }
  : null;

const articleJsonLd = isLesson
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: pageTitle,
      description: pageDescription,
      inLanguage: currentLocale,
      url: canonicalUrl,
      image: OG_IMAGE,
      author: { '@type': 'Person', name: AUTHOR_NAME, url: AUTHOR_URL },
      publisher: { '@type': 'Person', name: AUTHOR_NAME, url: AUTHOR_URL },
      isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
      ...(educationalLevel ? { educationalLevel } : {}),
      ...(articleSection ? { articleSection } : {}),
      learningResourceType: 'Lesson',
    }
  : null;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description:
    'A free, bilingual (English + Italian) manual that teaches non-technical readers how to use conversational AI well, from the basics to advanced topics.',
  inLanguage: ['en', 'it'],
  publisher: { '@type': 'Person', name: AUTHOR_NAME, url: AUTHOR_URL },
};
---

<script is:inline>
  // Assisted reading (see `src/scripts/reading-mode.ts`): mirror the
  // stored preference onto `<html>` before first paint, so the toggle
  // button in the header can reflect the correct state immediately and
  // CSS scoped to `[data-reading-mode='on']` (if ever added) doesn't
  // flash. The DOM-walking that bolds word-starts happens later, from
  // the `<ReadingToggle>` script, after `.sl-markdown-content` exists.
  try {
    if (localStorage.getItem('aiguide:reading-mode') === 'on') {
      document.documentElement.dataset.readingMode = 'on';
    }
  } catch (_) {
    /* localStorage non disponibile: default a off, nessun problema. */
  }
</script>

<script is:inline define:vars={{ titleMap }}>
  window.__AIGUIDE_TITLES__ = titleMap;
</script>

<Default><slot /></Default>

<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={OG_IMAGE_ALT} />
<meta property="og:locale:alternate" content={alternateLocale} />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="author" content={AUTHOR_NAME} />
{isLesson && <meta property="article:author" content={AUTHOR_URL} />}
{articleSection && <meta property="article:section" content={articleSection} />}
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<meta name="theme-color" content="#FCEEE3" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1C130D" media="(prefers-color-scheme: dark)" />

<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
{articleJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
)}
{breadcrumbJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
)}

{import.meta.env.PROD && (
  <>
    {/*
      Pre-init queue per `sa_event`. Lo script SA è async: senza questo
      stub, un click molto rapido (es. sul bottone "Copia esercizio")
      potrebbe sparare `sa_event(...)` quando la funzione non esiste
      ancora. Lo stub la definisce come buffer: SA, al load, trova
      `.q` e flussa la coda. In dev questo blocco non viene emesso, lo
      stub non accumula coda fuori produzione.
    */}
    <script is:inline>
      window.sa_event = window.sa_event || function () {
        var a = [].slice.call(arguments);
        var q = window.sa_event.q = window.sa_event.q || [];
        q.push(a);
      };
    </script>
    <script async is:inline src="/sa/proxy.js" data-collect-dnt="true"></script>
  </>
)}

<ClientRouter />

<script>
  import '../scripts/progress.ts';
</script>

<script>
  import '../scripts/sidebar-scroll.ts';
</script>

<script>
  import { registerSW } from 'virtual:pwa-register';

  if (typeof window !== 'undefined' && 'serviceWorker' in navigator) {
    registerSW({ immediate: true });
  }
</script>
