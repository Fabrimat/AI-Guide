---
/**
 * HomeCards: griglia di card visive per la landing.
 *
 * Sostituisce la lista a punti delle homepage "da docs" con schede
 * stile indice: ognuna con icona, titolo, frase. Pensato come
 * orientamento per il pubblico non-tecnico: "da dove parti?".
 *
 * L'icona è un `IconName` (vedi Icon.astro), non un emoji: disegno a
 * penna biro, stabile tra OS. Le schede sono cartoncini appoggiati
 * sul quaderno, appena inclinati.
 *
 * Uso in un file .mdx (tipicamente index.mdx con `template: splash`):
 *
 *   <HomeCards
 *     heading="Da dove parti?"
 *     cards={[
 *       {
 *         icon: 'sprout',
 *         title: 'Fondamenti',
 *         description: "Cos'è un'IA, come parlarci…",
 *         href: '/it/fundamentals/what-is-ai/',
 *       },
 *       {
 *         icon: 'pencil',
 *         title: 'Uso quotidiano',
 *         description: 'Scrivere, riassumere, imparare.',
 *         comingSoon: true,
 *       },
 *     ]}
 *   />
 *
 * Se `comingSoon` è true, la card non è cliccabile e mostra un badge
 * "Presto". Se `href` è assente e `comingSoon` non è true, la card
 * resta non-cliccabile (senza badge).
 */
import Icon, { type IconName } from './Icon.astro';
import { t } from '../i18n/ui';

export interface HomeCard {
  icon: IconName;
  title: string;
  description: string;
  href?: string;
  comingSoon?: boolean;
}

interface Props {
  heading?: string;
  cards: HomeCard[];
  comingSoonLabel?: string;
}

const ui = t(Astro.currentLocale);

const { heading, cards, comingSoonLabel = ui.comingSoonLabel } = Astro.props;
---

<section class="home-cards not-content">
  {heading && <h2 class="home-cards-heading">{heading}</h2>}
  <div class="home-cards-grid">
    {cards.map((card) => {
      const isLink = !!card.href && !card.comingSoon;
      const Tag = isLink ? 'a' : 'div';
      const props = isLink ? { href: card.href } : {};
      return (
        <Tag class:list={['home-card', { 'is-coming': card.comingSoon }]} {...props}>
          <Icon name={card.icon} class="home-card-icon" />
          <h3 class="home-card-title">{card.title}</h3>
          <p class="home-card-desc">{card.description}</p>
          {card.comingSoon && (
            <span class="home-card-badge">{comingSoonLabel}</span>
          )}
        </Tag>
      );
    })}
  </div>
</section>

<style>
  .home-cards {
    margin: 3rem auto 1rem;
    max-width: 1000px;
    padding: 0 1rem;
  }

  /* Written on the page like a notebook heading. */
  .home-cards-heading {
    font-family: var(--aig-font-hand);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--aig-heading);
    margin: 0 0 1.5rem;
  }

  .home-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1.25rem;
  }

  /* Index-card slip: white paper, ink border, hard shadow, tilted a
     hair so the set looks pinned by hand rather than gridded. */
  .home-card {
    position: relative;
    display: block;
    background: var(--aig-elevated-bg);
    border: var(--aig-border-width) solid var(--sl-color-hairline-shade);
    border-radius: var(--aig-radius);
    padding: 1.35rem 1.3rem 1.4rem;
    text-decoration: none;
    color: var(--sl-color-text);
    box-shadow: var(--aig-shadow-hard);
    transform: rotate(-0.5deg);
  }
  .home-card:nth-child(even) {
    transform: rotate(0.45deg);
  }
  .home-card:nth-child(3n) {
    transform: rotate(-0.25deg);
  }

  /* The ruled line of an index card, under the icon. */
  .home-card::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 4.6rem;
    border-top: 1.5px solid var(--aig-margin-line);
    pointer-events: none;
  }

  .home-card-icon {
    display: block;
    margin-bottom: 1.35rem;
  }

  /* Only clickable cards react: straighten, ink border, highlighter
     swipe under the title. */
  a.home-card:hover {
    transform: rotate(0deg);
    border-color: var(--aig-ink);
  }
  a.home-card:hover .home-card-title {
    background-image: var(--aig-highlight-stroke);
    background-repeat: no-repeat;
    background-position: 0 90%;
    background-size: 100% 45%;
  }
  a.home-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  .home-card-title {
    display: inline;
    font-size: 1.25rem;
    font-weight: 780;
    letter-spacing: -0.01em;
    margin: 0;
    padding-inline: 0.1em;
    margin-inline-start: -0.1em;
    color: var(--aig-heading);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .home-card h3.home-card-title + .home-card-desc {
    margin-top: 0.6rem;
  }
  .home-card-desc {
    margin: 0;
    color: var(--sl-color-text);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .home-card.is-coming {
    border-style: dashed;
    box-shadow: none;
  }
  .home-card.is-coming .home-card-icon,
  .home-card.is-coming .home-card-title,
  .home-card.is-coming .home-card-desc {
    opacity: 0.75;
  }

  /* "Presto": the teacher's red pen, written in the corner. */
  .home-card-badge {
    position: absolute;
    top: 0.8rem;
    right: 1rem;
    font-family: var(--aig-font-hand);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--aig-red-pen);
    text-decoration: underline wavy;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
    transform: rotate(-4deg);
  }

  @media (max-width: 600px) {
    .home-cards-heading {
      font-size: 1.35rem;
    }
    .home-card {
      padding: 1.15rem 1.1rem 1.25rem;
    }
  }
</style>
