---
/**
 * Card che propone alla lettrice un'attività da svolgere con il proprio LLM.
 * Mostra titolo, descrizione e pulsanti per copiare/scaricare/aprire un file
 * `.txt` di istruzioni (servito staticamente da `/public/skills/`). Plain
 * text deliberato: niente markdown grezzo nel testo che viene incollato
 * nell'IA o aperto in un editor (vale anche per il pubblico non-tecnico).
 *
 * Due varianti:
 *  - `variant="practice"` (default): pratica guidata. Accento biro (penna rossa per review).
 *    Badge: spark glyph + "Esercizio con la tua IA".
 *  - `variant="review"`: verifica dell'apprendimento a fine lezione.
 *    Accento ocra. Badge: check-square glyph + "Verifica con la tua IA".
 *
 * Il meccanismo (file scaricabile + copia + apri) è identico in entrambe.
 * Cambia solo il framing visivo per distinguere "fai pratica" da
 * "controlla cosa hai capito".
 *
 * Uso (in un file .mdx):
 *   <LlmExercise
 *     title="Titolo"
 *     file="nome-file.txt"
 *     description="Breve descrizione opzionale"
 *     variant="practice"  // oppure "review", default "practice"
 *   />
 *
 * Solo la variante practice ha un diario: un <details> chiuso "Una cosa
 * che ho notato" con una textarea (max 500 caratteri), salvata con
 * debounce in localStorage (JOURNAL_KEY). Testo vuoto = voce cancellata.
 */
interface Props {
  title: string;
  file: string;
  description?: string;
  /**
   * Stima del tempo per completare l'attività, da indicare in formato
   * "X min" o "X-Y min" (es. "5 min", "5-7 min", "10 min"). Mostrata
   * sotto il titolo come "X min di esercizio" / "X min di verifica".
   */
  duration?: string;
  variant?: 'practice' | 'review';
}

import Glyph from './Glyph.astro';
import { t, getLocale } from '../i18n/ui';
const ui = t(Astro.currentLocale);
const locale = getLocale(Astro.currentLocale);

const { title, file, description, duration, variant = 'practice' } = Astro.props;

// Skill files live under /skills/<locale>/<file>. The same `file` prop
// (e.g. "review-what-is-ai.txt") resolves to the right path per locale,
// so authors don't have to know about the convention.
const fileUrl = `${import.meta.env.BASE_URL}skills/${locale}/${file}`.replace(/\/+/g, '/');

const labels = {
  practice: { icon: 'spark', badge: ui.practiceBadge, durationSuffix: ui.practiceDuration },
  review: { icon: 'check-square', badge: ui.reviewBadge, durationSuffix: ui.reviewDuration },
} as const;
const { icon, badge, durationSuffix } = labels[variant];
---

<aside
  class:list={['llm-exercise', 'not-content', `is-${variant}`]}
  data-i18n-copied={ui.llmExerciseCopied}
  data-i18n-error={ui.llmExerciseError}
  data-file={file}
  data-variant={variant}
>
  <header>
    <span class="badge"><Glyph name={icon} /> {badge}</span>
    <h3>{title}</h3>
  </header>

  {duration && <p class="duration">{duration} {durationSuffix}</p>}

  {description && <p class="desc">{description}</p>}

  <p class="howto" set:html={ui.llmExerciseHowTo}></p>

  <div class="actions">
    <button type="button" class="btn btn-primary" data-copy-src={fileUrl} aria-live="polite">
      {ui.llmExerciseCopy}
    </button>
    <a class="btn" href={fileUrl} download>
      {ui.llmExerciseDownload}
    </a>
    <a class="btn btn-ghost" href={fileUrl} target="_blank" rel="noopener">
      {ui.llmExerciseOpen}
    </a>
  </div>

  {variant === 'practice' && (
    <details class="journal" data-journal data-journal-file={file}>
      <summary>{ui.journalSummary}</summary>
      <div class="journal-body">
        <textarea
          rows="3"
          maxlength="500"
          aria-label={ui.journalSummary}
          placeholder={ui.journalPlaceholder}
          data-journal-input
        ></textarea>
        <p class="journal-note">{ui.journalPrivacy}</p>
      </div>
    </details>
  )}
</aside>

<script>
  import { track } from '../scripts/analytics';
  import { JOURNAL_KEY } from '../scripts/storage-keys';

  // ----- Practice journal -----
  // Shape: Record<lessonPath, Record<exerciseFile, { text, updatedAt }>>.
  // Empty text deletes the entry (and the lesson bucket when it empties).
  type JournalEntry = { text: string; updatedAt: string };
  type Journal = Record<string, Record<string, JournalEntry>>;

  function lessonPath(): string {
    const p = location.pathname;
    return p.endsWith('/') ? p : `${p}/`;
  }

  function readJournal(): Journal {
    try {
      const raw = localStorage.getItem(JOURNAL_KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
    } catch {
      return {};
    }
  }

  function saveJournalEntry(file: string, text: string) {
    try {
      const journal = readJournal();
      const path = lessonPath();
      const bucket = journal[path] ?? {};
      if (text.trim()) {
        bucket[file] = { text: text.slice(0, 500), updatedAt: new Date().toISOString() };
        journal[path] = bucket;
      } else {
        delete bucket[file];
        if (Object.keys(bucket).length) journal[path] = bucket;
        else delete journal[path];
      }
      if (Object.keys(journal).length) {
        localStorage.setItem(JOURNAL_KEY, JSON.stringify(journal));
      } else {
        localStorage.removeItem(JOURNAL_KEY);
      }
    } catch {
      /* storage unavailable or full: the note just isn't saved */
    }
  }

  const pendingSaves = new Map<HTMLTextAreaElement, number>();

  function flushJournal() {
    pendingSaves.forEach((timer, area) => {
      window.clearTimeout(timer);
      const file = area.closest<HTMLElement>('[data-journal]')?.dataset.journalFile;
      if (file) saveJournalEntry(file, area.value);
    });
    pendingSaves.clear();
  }

  function initJournals() {
    document.querySelectorAll<HTMLElement>('[data-journal]').forEach((box) => {
      if (box.dataset.journalWired === 'true') return;
      box.dataset.journalWired = 'true';
      const file = box.dataset.journalFile || '';
      const area = box.querySelector<HTMLTextAreaElement>('[data-journal-input]');
      if (!file || !area) return;

      const saved = readJournal()[lessonPath()]?.[file];
      if (saved?.text) {
        area.value = saved.text;
        (box as HTMLDetailsElement).open = true;
      }

      area.addEventListener('input', () => {
        const prev = pendingSaves.get(area);
        if (prev) window.clearTimeout(prev);
        pendingSaves.set(
          area,
          window.setTimeout(() => {
            pendingSaves.delete(area);
            saveJournalEntry(file, area.value);
          }, 500),
        );
      });
      area.addEventListener('blur', flushJournal);
    });
  }

  document.addEventListener('astro:before-swap', flushJournal);
  window.addEventListener('pagehide', flushJournal);
  initJournals();
  document.addEventListener('astro:page-load', initJournals);

  // One reset timer per copy button, so rapid clicks don't restore the
  // label early.
  const labelTimers = new WeakMap<HTMLElement, number>();

  document.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement) || !target.matches('button[data-copy-src]')) {
      return;
    }
    const src = target.getAttribute('data-copy-src');
    if (!src) return;

    // Localized feedback strings come from the nearest .llm-exercise wrapper.
    const wrapper = target.closest<HTMLElement>('.llm-exercise');
    const copied = wrapper?.dataset.i18nCopied || '';
    const error = wrapper?.dataset.i18nError || '';
    // Etichetta originale salvata una sola volta (click ripetuti).
    const original = (target.dataset.label ??= target.textContent ?? '');

    track('exercise_copy', {
      file: wrapper?.dataset.file || '',
      variant: wrapper?.dataset.variant || 'practice',
    });

    try {
      const res = await fetch(src);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      await navigator.clipboard.writeText(text);
      target.textContent = copied;
    } catch (err) {
      console.error('[LlmExercise] copy failed:', err);
      target.textContent = error;
    } finally {
      const prev = labelTimers.get(target);
      if (prev) window.clearTimeout(prev);
      labelTimers.set(
        target,
        window.setTimeout(() => {
          target.textContent = original;
        }, 2000),
      );
    }
  });

  // Download / open buttons are <a> tags handled by the browser. Track
  // the click intent so we know which exercises are pulled in formats
  // other than copy (downloaded to disk, opened in a new tab).
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const link = target.closest<HTMLAnchorElement>('.llm-exercise .actions a');
    if (!link) return;
    const wrapper = link.closest<HTMLElement>('.llm-exercise');
    if (!wrapper) return;
    const kind = link.hasAttribute('download') ? 'download' : 'open';
    track(`exercise_${kind}`, {
      file: wrapper.dataset.file || '',
      variant: wrapper.dataset.variant || 'practice',
    });
  });
</script>

<style>
  /* A slip of paper. `--pen` is the colour the variant is written in:
     biro for practice, red pen for the review check-in. */
  .llm-exercise {
    --pen: var(--aig-ink);
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border: var(--aig-border-width) solid var(--pen);
    border-radius: var(--aig-radius);
    background: var(--aig-elevated-bg);
  }
  .llm-exercise.is-review {
    --pen: var(--aig-red-pen);
  }
  .llm-exercise header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .badge {
    font-family: var(--aig-font-hand);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--pen);
  }
  .llm-exercise h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .duration {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    font-weight: 500;
  }
  .desc {
    margin: 0.5rem 0 0;
  }
  .howto {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 600;
    border: var(--aig-border-width) solid var(--aig-ink);
    border-radius: var(--aig-radius);
    background: transparent;
    color: var(--aig-ink);
    cursor: pointer;
    text-decoration: none;
  }
  .btn:hover {
    background: var(--aig-hover-wash);
  }
  .btn:focus-visible {
    outline: 2px solid var(--aig-ink);
    outline-offset: 2px;
  }
  .btn-primary {
    background: var(--aig-ink);
    color: var(--aig-on-accent);
  }
  .btn-primary:hover {
    background: var(--aig-accent-hover);
    border-color: var(--aig-accent-hover);
  }
  .btn-ghost {
    border-color: transparent;
  }

  /* ----- practice journal ----- */
  .journal {
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .journal summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--aig-ink);
  }
  .journal summary:focus-visible {
    outline: 2px solid var(--aig-ink);
    outline-offset: 2px;
    border-radius: 3px;
  }
  .journal-body {
    margin-top: 0.5rem;
  }
  /* The reader's own handwriting: the annotation voice. */
  .journal textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--aig-font-hand);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--aig-ink);
    background: var(--aig-elevated-bg);
    border: var(--aig-border-width) solid var(--aig-field-border);
    border-radius: var(--aig-radius);
    padding: 0.5rem 0.65rem;
    resize: vertical;
  }
  .journal textarea:focus {
    outline: 2px solid var(--aig-ink);
    outline-offset: 1px;
    border-color: var(--aig-ink);
  }
  .journal-note {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
</style>
