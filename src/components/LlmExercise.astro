---
/**
 * Card che propone alla lettrice un'attività da svolgere con il proprio LLM.
 * Mostra titolo, descrizione e pulsanti per copiare/scaricare/aprire un file
 * `.txt` di istruzioni (servito staticamente da `/public/skills/`). Plain
 * text deliberato: niente markdown grezzo nel testo che viene incollato
 * nell'IA o aperto in un editor (vale anche per il pubblico non-tecnico).
 *
 * Due varianti:
 *  - `variant="practice"` (default): pratica guidata. Accento coral.
 *    Badge: "🤖 Esercizio con la tua IA".
 *  - `variant="review"`: verifica dell'apprendimento a fine lezione.
 *    Accento ocra. Badge: "📝 Verifica con la tua IA".
 *
 * Il meccanismo (file scaricabile + copia + apri) è identico in entrambe.
 * Cambia solo il framing visivo per distinguere "fai pratica" da
 * "controlla cosa hai capito".
 *
 * Uso (in un file .mdx):
 *   <LlmExercise
 *     title="Titolo"
 *     file="nome-file.txt"
 *     description="Breve descrizione opzionale"
 *     variant="practice"  // oppure "review", default "practice"
 *   />
 */
interface Props {
  title: string;
  file: string;
  description?: string;
  variant?: 'practice' | 'review';
}

const { title, file, description, variant = 'practice' } = Astro.props;
const fileUrl = `${import.meta.env.BASE_URL}skills/${file}`.replace(/\/+/g, '/');

const labels = {
  practice: { icon: '🤖', badge: 'Esercizio con la tua IA' },
  review: { icon: '📝', badge: 'Verifica con la tua IA' },
} as const;
const { icon, badge } = labels[variant];
---

<aside class:list={['llm-exercise', 'not-content', `is-${variant}`]}>
  <header>
    <span class="badge">{icon} {badge}</span>
    <h3>{title}</h3>
  </header>

  {description && <p class="desc">{description}</p>}

  <p class="howto">
    Copia il testo qui sotto e incollalo nella tua IA preferita
    (<strong>Claude</strong>, <strong>ChatGPT</strong>, <strong>Gemini</strong>
    o un'altra). In alternativa scarica il file e dallo all'IA come allegato.
  </p>

  <div class="actions">
    <button type="button" class="btn btn-primary" data-copy-src={fileUrl}>
      Copia il testo
    </button>
    <a class="btn" href={fileUrl} download>
      Scarica
    </a>
    <a class="btn btn-ghost" href={fileUrl} target="_blank" rel="noopener">
      Apri
    </a>
  </div>
</aside>

<script>
  document.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement) || !target.matches('button[data-copy-src]')) {
      return;
    }
    const src = target.getAttribute('data-copy-src');
    if (!src) return;

    const original = target.textContent ?? '';
    try {
      const res = await fetch(src);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      await navigator.clipboard.writeText(text);
      target.textContent = '✅ Copiato!';
    } catch (err) {
      console.error('[LlmExercise] copy failed:', err);
      target.textContent = '❌ Errore, riprova';
    } finally {
      window.setTimeout(() => {
        target.textContent = original;
      }, 2000);
    }
  });
</script>

<style>
  .llm-exercise {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-accent);
    border-left-width: 4px;
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
  }
  .llm-exercise header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .badge {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-accent-high);
  }
  .llm-exercise h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .desc {
    margin: 0.5rem 0 0;
  }
  .howto {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
    text-decoration: none;
  }
  .btn:hover {
    background: var(--sl-color-gray-6);
  }
  .btn-primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    border-color: var(--sl-color-accent);
  }
  .btn-primary:hover {
    background: var(--sl-color-accent-high);
  }
  .btn-ghost {
    background: transparent;
  }

  /* ----- variant="review" -----
     Stessa struttura della pratica, ma con accento ocra (riprende la
     palette del callout :::caution) per distinguere visivamente
     "controlla cosa hai capito" da "fai pratica". Il bottone primary
     resta coral per coerenza dei CTA del sito. */
  .llm-exercise.is-review {
    border-color: #d4a248;
    background: #fbe9c0;
  }
  .llm-exercise.is-review .badge {
    color: #8a5a18;
  }
</style>
