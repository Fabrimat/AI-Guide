---
/**
 * ShareLesson: riga di icone per condividere la lezione corrente.
 *
 * Auto-iniettato dal `Footer.astro` override sulle pagine con
 * `livello` in frontmatter (= lezioni), subito prima della card
 * "Prossima lezione". Non si include mai manualmente dentro un
 * `.mdx`: posizione e presenza sono decise centralmente, così lo
 * stile della pagina resta coerente fra lezioni.
 *
 * Niente tracker né SDK di terze parti: le icone sono link a intent
 * URL (`twitter.com/intent/tweet`, `linkedin.com/sharing/share-offsite`,
 * `wa.me/?text=`, `mailto:`). L'unica cosa che parte al click è la
 * richiesta naturale del browser verso il sito di destinazione. In
 * particolare non usiamo `navigator.share()` perché su desktop
 * aprirebbe il foglio di condivisione del sistema operativo, che
 * spesso è vuoto o confuso: una riga di icone esplicite è più
 * prevedibile per il pubblico non-tecnico.
 *
 * Il bottone "Copia link" scrive nel clipboard l'URL canonico e
 * mostra un feedback inline per 2 secondi.
 */
import { t } from '../i18n/ui';

interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const ui = t(Astro.currentLocale);

// Encode una sola volta. Il titolo finisce in più URL, ciascuno lo
// gestisce leggermente diverso ma `encodeURIComponent` è sicuro per
// query-string in tutti e quattro i casi.
const encUrl = encodeURIComponent(url);
const encTitle = encodeURIComponent(title);

const xHref = `https://twitter.com/intent/tweet?text=${encTitle}&url=${encUrl}`;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encUrl}`;
// `wa.me` senza numero apre il selettore contatti. Il testo include
// titolo + URL perché WhatsApp non separa i due come X/LinkedIn.
const whatsappHref = `https://wa.me/?text=${encTitle}%20${encUrl}`;
const emailSubject = encodeURIComponent(ui.shareEmailSubject(title));
const emailHref = `mailto:?subject=${emailSubject}&body=${encUrl}`;
---

<aside class="share-lesson not-content" aria-labelledby="share-heading">
  <span class="share-heading" id="share-heading">{ui.shareHeading}</span>
  <ul class="share-list">
    <li>
      <a
        class="share-btn"
        href={xHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ui.shareXAria}
        title={ui.shareXAria}
        data-share-network="x"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </li>
    <li>
      <a
        class="share-btn"
        href={linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ui.shareLinkedInAria}
        title={ui.shareLinkedInAria}
        data-share-network="linkedin"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.063 2.063 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </li>
    <li>
      <a
        class="share-btn"
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ui.shareWhatsAppAria}
        title={ui.shareWhatsAppAria}
        data-share-network="whatsapp"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.45L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.87 9.87 0 0 0 1.675 5.488l.116.193-1.004 3.67 3.769-.99.033.02zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>
    </li>
    <li>
      <a
        class="share-btn"
        href={emailHref}
        aria-label={ui.shareEmailAria}
        title={ui.shareEmailAria}
        data-share-network="email"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="M3 7l9 6 9-6" />
        </svg>
      </a>
    </li>
    <li>
      <button
        type="button"
        class="share-btn share-copy"
        data-share-copy
        data-share-url={url}
        data-i18n-copied={ui.shareCopied}
        data-i18n-error={ui.shareCopyError}
        aria-label={ui.shareCopyAria}
        title={ui.shareCopyAria}
        data-share-network="copy"
      >
        <svg class="share-copy-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" />
          <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" />
        </svg>
        <span class="share-copy-label">{ui.shareCopyLabel}</span>
      </button>
    </li>
  </ul>
  <p class="share-status" data-share-status aria-live="polite"></p>
</aside>

<script>
  import { track } from '../scripts/analytics';

  // Delegated tracking for every share button/link. Fires on the same
  // click that triggers the intent URL or the copy. SA's request goes
  // out before the new tab swallows the page lifecycle, so the event
  // is reliable enough for aggregate counts.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const el = target.closest<HTMLElement>('.share-lesson [data-share-network]');
    if (!el) return;
    track('share_click', { network: el.dataset.shareNetwork || '' });
  });

  // One pending reset timer per status element: a second click clears the
  // previous timer so it can't wipe the new message early.
  const resetTimers = new WeakMap<HTMLElement, number>();

  function init() {
    document
      .querySelectorAll<HTMLButtonElement>('button[data-share-copy]')
      .forEach((btn) => {
        if (btn.dataset.scWired === 'true') return;
        btn.dataset.scWired = 'true';

        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-share-url') || '';
          if (!url) return;
          const status = btn
            .closest('.share-lesson')
            ?.querySelector<HTMLElement>('[data-share-status]');
          const copied = btn.dataset.i18nCopied || '';
          const error = btn.dataset.i18nError || '';
          try {
            await navigator.clipboard.writeText(url);
            if (status) {
              status.textContent = copied;
              status.classList.remove('is-error');
            }
          } catch {
            if (status) {
              status.textContent = error;
              status.classList.add('is-error');
            }
          }
          if (status) {
            const prev = resetTimers.get(status);
            if (prev) window.clearTimeout(prev);
            resetTimers.set(
              status,
              window.setTimeout(() => {
                status.textContent = '';
                status.classList.remove('is-error');
                resetTimers.delete(status);
              }, 2000),
            );
          }
        });
      });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .share-lesson {
    margin: 2.5rem 0 0;
    padding: 1rem 1.25rem;
    background: var(--aig-elevated-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 1rem;
    box-shadow:
      0 1px 0 rgba(var(--aig-shadow-color), 0.04),
      0 4px 12px rgba(var(--aig-shadow-color), 0.04);
  }

  .share-heading {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.6rem;
  }

  .share-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border-radius: 999px;
    border: 1px solid var(--sl-color-hairline);
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
    font-size: 0.85rem;
  }

  .share-btn:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent-low);
    color: var(--sl-color-text);
  }

  .share-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* Copia link ha anche label testuale, quindi è più larga. */
  .share-copy {
    width: auto;
    padding-inline: 0.85rem;
  }

  .share-copy-label {
    font-weight: 500;
  }

  .share-status {
    margin: 0.6rem 0 0;
    min-height: 1.1em;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }

  .share-status.is-error {
    color: var(--sl-color-accent-high);
  }

  /* Su mobile molto stretto, nascondo il testo del copy-link per
     stare in una riga sola con le altre icone. Il `title` resta
     leggibile su long-press. */
  @media (max-width: 420px) {
    .share-copy {
      width: 2.4rem;
      padding-inline: 0;
    }
    .share-copy-label {
      display: none;
    }
  }
</style>
