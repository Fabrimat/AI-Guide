---
/**
 * GlossaryTerm: voce di un glossario. Riceve `name` come prop, il
 * contenuto della definizione come slot (così puoi usare emfasi,
 * link, ecc. dentro la definizione). Aggiunge un bottone "Spiegamelo
 * meglio con la tua IA" che, al click, copia un prompt calibrato sul
 * termine nel clipboard del lettore.
 *
 * Uso:
 *   <GlossaryTerm name="Allucinazione">
 *     Quando l'IA produce un testo che suona vero ma non si basa su
 *     nessun fatto reale.
 *   </GlossaryTerm>
 */
interface Props {
  name: string;
}

const { name } = Astro.props;
const slug = name
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
---

<article class="glossary-term not-content" id={slug}>
  <h3 class="gt-name">{name}</h3>
  <div class="gt-def">
    <slot />
  </div>
  <button
    type="button"
    class="gt-explain"
    data-glossary-term={name}
  >
    Spiegamelo meglio con la tua IA
  </button>
</article>

<script>
  function buildPrompt(term: string): string {
    return `Sei un tutor amichevole di un manuale di IA per principianti. Spiegami con parole semplici cosa significa "${term}" nel contesto delle IA conversazionali (ChatGPT, Claude, Gemini). Usa un esempio concreto preso dalla vita di tutti i giorni. Tono incoraggiante, niente gergo. Massimo 200 parole.

Se dopo ho domande di approfondimento, lasciami chiederle e rispondi sempre con la stessa accessibilità.`;
  }

  function init() {
    document
      .querySelectorAll<HTMLButtonElement>('button[data-glossary-term]')
      .forEach((btn) => {
        if (btn.dataset.gtWired === 'true') return;
        btn.dataset.gtWired = 'true';

        btn.addEventListener('click', async () => {
          const term = btn.getAttribute('data-glossary-term');
          if (!term) return;
          const original = btn.textContent ?? '';
          try {
            await navigator.clipboard.writeText(buildPrompt(term));
            btn.textContent = '✅ Prompt copiato! Incollalo nella tua IA';
          } catch {
            btn.textContent = '❌ Errore, riprova';
          }
          window.setTimeout(() => {
            btn.textContent = original;
          }, 3000);
        });
      });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .glossary-term {
    padding: 1.1rem 1.25rem 1rem;
    margin: 1.25rem 0;
    background: #ffffff;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.85rem;
    box-shadow:
      0 1px 0 rgba(42, 36, 71, 0.04),
      0 4px 12px rgba(42, 36, 71, 0.04);
    scroll-margin-top: 1rem;
  }

  .gt-name {
    margin: 0 0 0.55rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--sl-color-text);
    letter-spacing: -0.005em;
  }

  .gt-def {
    color: var(--sl-color-text);
    line-height: 1.6;
    font-size: 0.95rem;
    margin-bottom: 0.85rem;
  }

  .gt-def :global(p) {
    margin: 0 0 0.6rem;
  }

  .gt-def :global(p:last-child) {
    margin-bottom: 0;
  }

  .gt-def :global(em) {
    font-style: italic;
  }

  .gt-def :global(strong) {
    font-weight: 700;
  }

  .gt-def :global(code) {
    background: var(--sl-color-bg-inline-code);
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
    font-size: 0.92em;
  }

  .gt-explain {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    background: transparent;
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-hairline);
    cursor: pointer;
  }

  .gt-explain:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }

  .gt-explain:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
